<?xml version="1.0" encoding="utf-8"?>
<!--
  The door keeps an offline roster (barcode secrets, sealed with a per-device
  key) and the queue of offline scans in the web view's storage. None of it
  may leave the device in a cloud backup or a device-to-device transfer: a
  restored copy would carry another phone's door data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
