{
  "name": "exos-door-native",
  "private": true,
  "version": "0.1.0",
  "description": "Exos Door: the Capacitor shell (iOS + Android) around the bundled Exos SPA. See docs/native-apps.md.",
  "type": "module",
  "scripts": {
    "build:web": "npm --prefix ../.. run build:native",
    "sync": "npm run build:web && cap sync",
    "check": "tsc --noEmit -p tsconfig.json",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-mlkit/barcode-scanning": "8.2.2",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capgo/capacitor-social-login": "8.7.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "typescript": "5.8.3"
  }
}
