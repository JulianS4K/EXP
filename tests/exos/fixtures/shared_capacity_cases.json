{
  "about": "Shared cases for pool availability: exos_effective_available (tests/exos/test_shared_capacity.sql, SC1) and sharedAvailability in src/lib/quotas.ts (src/lib/sharedCapacity.test.ts). A type sells only when every pool it is in has room: available = min(type remaining, each pool's remaining). sold = tickets minted, held = live holds.",
  "cases": [
    { "name": "no pools: the type's own remaining",
      "types": [ { "key": "ga", "capacity": 10, "sold": 3, "held": 2 } ], "pools": [],
      "expect": { "ga": 5 } },
    { "name": "room of 5 across GA, VIP, Student; VIP capped at 3",
      "types": [ { "key": "ga", "capacity": 10, "sold": 2, "held": 0 }, { "key": "vip", "capacity": 3, "sold": 0, "held": 0 },
                 { "key": "student", "capacity": 10, "sold": 1, "held": 0 } ],
      "pools": [ { "key": "room", "allocation": 5, "closed": false, "members": ["ga", "vip", "student"] } ],
      "expect": { "ga": 2, "vip": 2, "student": 2 } },
    { "name": "a type in two pools: the tighter one wins",
      "types": [ { "key": "ga", "capacity": 10, "sold": 1, "held": 0 }, { "key": "vip", "capacity": 5, "sold": 1, "held": 0 } ],
      "pools": [ { "key": "room", "allocation": 8, "closed": false, "members": ["ga", "vip"] },
                 { "key": "balcony", "allocation": 2, "closed": false, "members": ["vip"] } ],
      "expect": { "ga": 6, "vip": 1 } },
    { "name": "holds count against the pool",
      "types": [ { "key": "ga", "capacity": 10, "sold": 1, "held": 3 }, { "key": "vip", "capacity": 10, "sold": 0, "held": 0 } ],
      "pools": [ { "key": "room", "allocation": 5, "closed": false, "members": ["ga", "vip"] } ],
      "expect": { "ga": 1, "vip": 1 } },
    { "name": "a full pool: sold out everywhere it reaches",
      "types": [ { "key": "ga", "capacity": 10, "sold": 3, "held": 0 }, { "key": "vip", "capacity": 10, "sold": 1, "held": 0 },
                 { "key": "other", "capacity": 4, "sold": 0, "held": 0 } ],
      "pools": [ { "key": "room", "allocation": 4, "closed": false, "members": ["ga", "vip"] } ],
      "expect": { "ga": 0, "vip": 0, "other": 4 } },
    { "name": "allocation 0 closes the pool",
      "types": [ { "key": "ga", "capacity": 10, "sold": 0, "held": 0 } ],
      "pools": [ { "key": "room", "allocation": 0, "closed": false, "members": ["ga"] } ],
      "expect": { "ga": 0 } },
    { "name": "closed flag closes it too",
      "types": [ { "key": "ga", "capacity": 10, "sold": 0, "held": 0 } ],
      "pools": [ { "key": "room", "allocation": 50, "closed": true, "members": ["ga"] } ],
      "expect": { "ga": 0 } },
    { "name": "a closed type stays closed inside an open pool",
      "types": [ { "key": "ga", "capacity": 0, "sold": 0, "held": 0 }, { "key": "vip", "capacity": 5, "sold": 0, "held": 0 } ],
      "pools": [ { "key": "room", "allocation": 50, "closed": false, "members": ["ga", "vip"] } ],
      "expect": { "ga": 0, "vip": 5 } },
    { "name": "a pool with no members limits nothing",
      "types": [ { "key": "ga", "capacity": 7, "sold": 2, "held": 0 } ],
      "pools": [ { "key": "empty", "allocation": 1, "closed": false, "members": [] } ],
      "expect": { "ga": 5 } }
  ]
}
