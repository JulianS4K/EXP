{
  "about": "Shared cases for exos_tier_current_price (tests/exos/test_price_steps.sql, PS1) and its TypeScript mirror currentPriceStep (src/lib/priceSteps.test.ts). 'used' is tickets sold at the step + live holds on it. Step keys name steps; the SQL side gives them uuids.",
  "cases": [
    { "name": "no steps: the type's price", "base_price_cents": 2000, "door_price_cents": null, "at": "2026-11-20T12:00:00Z", "channel": "online",
      "steps": [],
      "expect": { "price_cents": 2000, "source": "base", "step": null, "step_index": null, "step_remaining": null, "next_price_cents": null } },
    { "name": "door channel with a door price", "base_price_cents": 2000, "door_price_cents": 3500, "at": "2026-11-20T12:00:00Z", "channel": "door",
      "steps": [ { "key": "eb", "name": "Early bird", "price_cents": 2000, "ends_after_count": 100, "ends_at": null, "sold_out_at": null, "used": 0 },
                 { "key": "fin", "name": "Final", "price_cents": 3000, "ends_after_count": null, "ends_at": null, "sold_out_at": null, "used": 0 } ],
      "expect": { "price_cents": 3500, "source": "door", "step": null, "step_index": null, "step_remaining": null, "next_price_cents": null } },
    { "name": "pos channel without a door price: the current step", "base_price_cents": 2000, "door_price_cents": null, "at": "2026-11-20T12:00:00Z", "channel": "pos",
      "steps": [ { "key": "eb", "name": "Early bird", "price_cents": 2000, "ends_after_count": 100, "ends_at": null, "sold_out_at": null, "used": 10 },
                 { "key": "fin", "name": "Final", "price_cents": 3000, "ends_after_count": null, "ends_at": null, "sold_out_at": null, "used": 0 } ],
      "expect": { "price_cents": 2000, "source": "step", "step": "eb", "step_index": 1, "step_remaining": 90, "next_price_cents": 3000 } },
    { "name": "early bird with places left", "base_price_cents": 2000, "door_price_cents": 3500, "at": "2026-11-20T12:00:00Z", "channel": "online",
      "steps": [ { "key": "eb", "name": "Early bird", "price_cents": 2000, "ends_after_count": 100, "ends_at": "2026-12-01T00:00:00Z", "sold_out_at": null, "used": 40 },
                 { "key": "ga", "name": "GA", "price_cents": 2500, "ends_after_count": 200, "ends_at": null, "sold_out_at": null, "used": 0 },
                 { "key": "fin", "name": "Final", "price_cents": 3000, "ends_after_count": null, "ends_at": null, "sold_out_at": null, "used": 0 } ],
      "expect": { "price_cents": 2000, "source": "step", "step": "eb", "step_index": 1, "step_remaining": 60, "next_price_cents": 2500 } },
    { "name": "advance by count: 100 of 100 used", "base_price_cents": 2000, "door_price_cents": null, "at": "2026-11-20T12:00:00Z", "channel": "online",
      "steps": [ { "key": "eb", "name": "Early bird", "price_cents": 2000, "ends_after_count": 100, "ends_at": "2026-12-01T00:00:00Z", "sold_out_at": null, "used": 100 },
                 { "key": "ga", "name": "GA", "price_cents": 2500, "ends_after_count": 200, "ends_at": null, "sold_out_at": null, "used": 3 },
                 { "key": "fin", "name": "Final", "price_cents": 3000, "ends_after_count": null, "ends_at": null, "sold_out_at": null, "used": 0 } ],
      "expect": { "price_cents": 2500, "source": "step", "step": "ga", "step_index": 2, "step_remaining": 197, "next_price_cents": 3000 } },
    { "name": "advance by time: exactly at the end time", "base_price_cents": 2000, "door_price_cents": null, "at": "2026-12-01T00:00:00Z", "channel": "online",
      "steps": [ { "key": "eb", "name": "Early bird", "price_cents": 2000, "ends_after_count": 100, "ends_at": "2026-12-01T00:00:00Z", "sold_out_at": null, "used": 5 },
                 { "key": "fin", "name": "", "price_cents": 3000, "ends_after_count": null, "ends_at": null, "sold_out_at": null, "used": 0 } ],
      "expect": { "price_cents": 3000, "source": "step", "step": "fin", "step_index": 2, "step_remaining": null, "next_price_cents": null } },
    { "name": "one second before the end time", "base_price_cents": 2000, "door_price_cents": null, "at": "2026-11-30T23:59:59Z", "channel": "online",
      "steps": [ { "key": "eb", "name": "Early bird", "price_cents": 2000, "ends_after_count": null, "ends_at": "2026-12-01T00:00:00Z", "sold_out_at": null, "used": 5 },
                 { "key": "fin", "name": "", "price_cents": 3000, "ends_after_count": null, "ends_at": null, "sold_out_at": null, "used": 0 } ],
      "expect": { "price_cents": 2000, "source": "step", "step": "eb", "step_index": 1, "step_remaining": null, "next_price_cents": 3000 } },
    { "name": "latched: its count sold, a refund doesn't reopen it", "base_price_cents": 2000, "door_price_cents": null, "at": "2026-11-20T12:00:00Z", "channel": "online",
      "steps": [ { "key": "eb", "name": "Early bird", "price_cents": 2000, "ends_after_count": 100, "ends_at": null, "sold_out_at": "2026-11-10T00:00:00Z", "used": 99 },
                 { "key": "fin", "name": "Final", "price_cents": 3000, "ends_after_count": null, "ends_at": null, "sold_out_at": null, "used": 0 } ],
      "expect": { "price_cents": 3000, "source": "step", "step": "fin", "step_index": 2, "step_remaining": null, "next_price_cents": null } },
    { "name": "latched later than the asked time", "base_price_cents": 2000, "door_price_cents": null, "at": "2026-11-05T12:00:00Z", "channel": "online",
      "steps": [ { "key": "eb", "name": "Early bird", "price_cents": 2000, "ends_after_count": 100, "ends_at": null, "sold_out_at": "2026-11-10T00:00:00Z", "used": 99 },
                 { "key": "fin", "name": "Final", "price_cents": 3000, "ends_after_count": null, "ends_at": null, "sold_out_at": null, "used": 0 } ],
      "expect": { "price_cents": 2000, "source": "step", "step": "eb", "step_index": 1, "step_remaining": 1, "next_price_cents": 3000 } },
    { "name": "every step ended: the last one", "base_price_cents": 2000, "door_price_cents": null, "at": "2026-11-20T12:00:00Z", "channel": "online",
      "steps": [ { "key": "a", "name": "A", "price_cents": 1000, "ends_after_count": 2, "ends_at": null, "sold_out_at": null, "used": 2 },
                 { "key": "b", "name": "B", "price_cents": 1500, "ends_after_count": 3, "ends_at": null, "sold_out_at": null, "used": 7 } ],
      "expect": { "price_cents": 1500, "source": "step", "step": "b", "step_index": 2, "step_remaining": 0, "next_price_cents": null } },
    { "name": "one step only", "base_price_cents": 2000, "door_price_cents": null, "at": "2026-11-20T12:00:00Z", "channel": "online",
      "steps": [ { "key": "only", "name": "Standard", "price_cents": 4200, "ends_after_count": null, "ends_at": null, "sold_out_at": null, "used": 0 } ],
      "expect": { "price_cents": 4200, "source": "step", "step": "only", "step_index": 1, "step_remaining": null, "next_price_cents": null } },
    { "name": "skips two ended steps (time, then count)", "base_price_cents": 0, "door_price_cents": null, "at": "2026-11-20T12:00:00Z", "channel": "online",
      "steps": [ { "key": "a", "name": "Super early", "price_cents": 1500, "ends_after_count": null, "ends_at": "2026-11-01T00:00:00Z", "sold_out_at": null, "used": 0 },
                 { "key": "b", "name": "Early", "price_cents": 2000, "ends_after_count": 4, "ends_at": "2026-12-01T00:00:00Z", "sold_out_at": null, "used": 4 },
                 { "key": "c", "name": "GA", "price_cents": 2500, "ends_after_count": null, "ends_at": "2026-12-20T00:00:00Z", "sold_out_at": null, "used": 0 },
                 { "key": "d", "name": "", "price_cents": 3000, "ends_after_count": null, "ends_at": null, "sold_out_at": null, "used": 0 } ],
      "expect": { "price_cents": 2500, "source": "step", "step": "c", "step_index": 3, "step_remaining": null, "next_price_cents": 3000 } },
    { "name": "a free first step", "base_price_cents": 0, "door_price_cents": 1000, "at": "2026-11-20T12:00:00Z", "channel": "online",
      "steps": [ { "key": "free", "name": "First 10 free", "price_cents": 0, "ends_after_count": 10, "ends_at": null, "sold_out_at": null, "used": 9 },
                 { "key": "paid", "name": "", "price_cents": 1200, "ends_after_count": null, "ends_at": null, "sold_out_at": null, "used": 0 } ],
      "expect": { "price_cents": 0, "source": "step", "step": "free", "step_index": 1, "step_remaining": 1, "next_price_cents": 1200 } }
  ]
}
