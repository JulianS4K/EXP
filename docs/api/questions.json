                "answer_count": 42
              },
              {
                "id": "6d2f3e4a-5b6c-4d7e-9f8a-0b1c2d3e4f5a",
                "event_id": "3f2a9c10-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                "label": "I agree to the venue's photo policy",
                "help_text": null,
