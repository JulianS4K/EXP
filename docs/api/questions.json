    {
      "id": "create-event-question",
      "method": "POST",
      "path": "/v1/events/:id/questions",
      "summary": "Add a question",
      "description": "Adds a question at the end of the event's list (at most 50 questions that aren't archived). Body: the fields below, or wrapped as `{ \"question\": {...} }`. Needs a key created by an owner or manager.",
      "auth": "api_key",
      "scope": "events:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event's id.",
          "example": "3f2a9c10-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "label",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "The question as buyers see it, 1 to 200 characters.",
          "example": "T-shirt size"
        },
        {
          "name": "help_text",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "A line under the question, up to 500 characters.",
          "example": "We print on the night."
        },
        {
          "name": "kind",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "The answer type.",
          "example": "single_choice",
          "enum": [
            "text",
            "long_text",
            "single_choice",
            "multiple_choice",
            "checkbox",
            "number",
            "date",
            "phone",
            "email"
          ]
        },
        {
          "name": "options",
          "location": "body",
          "type": "array of strings",
          "required": false,
          "description": "single_choice / multiple_choice: 2 to 50 distinct options of 1 to 200 characters. Other kinds have none.",
          "example": [
            "S",
            "M",
            "L",
            "XL"
          ]
        },
        {
          "name": "required",
          "location": "body",
          "type": "boolean",
          "required": false,
          "description": "Buyers must answer it (a checkbox must be ticked). Default false. Making a question required later changes nothing for orders already placed.",
          "example": true
        },
        {
          "name": "scope",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "order: asked once per order. ticket: asked for every ticket (a table ticket type is asked per seat). Default order. Fixed once the question has answers.",
          "example": "ticket",
          "enum": [
            "order",
            "ticket"
          ]
        },
        {
          "name": "tier_ids",
          "location": "body",
          "type": "array of UUIDs",
          "required": false,
          "description": "Ask it only for these ticket types of the event; null or [] = every type.",
          "example": [
            "7e6d5c4b-3a29-4180-9f7e-6d5c4b3a2918"
          ]
        },
        {
          "name": "max_length",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "text: 1 to 2000 (default 500); long_text: 1 to 5000 (default 2000).",
          "example": 40
        },
        {
          "name": "min_choices",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "multiple_choice: at least this many picks when answered.",
          "example": 1
        },
        {
          "name": "max_choices",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "multiple_choice: at most this many picks (up to the number of options).",
          "example": 2
        },
        {
          "name": "min_value",
          "location": "body",
          "type": "number",
          "required": false,
          "description": "number: the smallest answer allowed.",
          "example": 0
        },
        {
          "name": "max_value",
          "location": "body",
          "type": "number",
          "required": false,
          "description": "number: the largest answer allowed.",
          "example": 120
        },
        {
          "name": "hidden",
          "location": "body",
          "type": "boolean",
          "required": false,
          "description": "Not asked at checkout; staff can still fill it at the door (and this API reads it). Answers are kept.",
          "example": false
        },
        {
          "name": "archived",
          "location": "body",
          "type": "boolean",
          "required": false,
          "description": "Archive (true) or restore (false). Archived questions are no longer asked; their answers are kept.",
          "example": false
        },
        {
          "name": "sort_order",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Position; or use PUT /v1/events/:id/questions/order.",
          "example": 0
        }
      ],
      "request_example": {
        "label": "T-shirt size",
        "kind": "single_choice",
        "options": [
          "S",
          "M",
          "L",
          "XL"
        ],
        "required": true,
        "scope": "ticket"
      },
      "responses": [
        {
          "status": 201,
          "description": "Created.",
          "example": {
            "data": {
              "id": "5c1e2d3f-4a5b-4c6d-8e7f-901a2b3c4d5e",
