              "sort_order": 0,
              "hidden": false,
              "archived": false,
              "archived_at": null,
              "created_at": "2026-11-05T12:00:00+00:00",
              "updated_at": "2026-11-05T12:00:00+00:00",
              "answer_count": 0
            }
          }
