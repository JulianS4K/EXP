          "name": "status",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only this status (or all, the default).",
          "enum": [
            "draft",
            "issued",
            "paid",
            "void",
            "all"
          ],
          "example": "issued"
        },
        {
          "name": "hold_id",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Only invoices for this hold."
        },
        {
