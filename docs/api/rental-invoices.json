{
  "file": "rental-invoices",
  "name": "Rental invoices",
  "order": 66.5,
  "description": "Invoices for renting a venue or room: for a hold, one held night, or a room on a date. Made from a rental invoice template (its lines, deposits, taxes and terms are copied, so later template edits don't change the invoice) or from scratch. Totals are computed by Exos: each line is quantity x cost (x attendance for per-head lines); the discount comes off the subtotal; each tax or fee is a rate of what is left. A draft can be edited and deleted. Issuing gives it the organization's next number (gapless: a number is never skipped or reused, and an issued invoice is never deleted); after that it is frozen and can only be marked paid or voided (a void invoice keeps its number). Money is in cents. Reads need `finance:read`, writes `finance:write`.",
  "endpoints": [
    {
      "id": "list-rental-invoices",
      "method": "GET",
      "path": "/v1/rental-invoices",
      "summary": "List rental invoices",
      "description": "Newest first.",
      "auth": "api_key",
