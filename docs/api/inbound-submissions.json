    {
      "id": "delete-inbound-submission",
      "method": "DELETE",
      "path": "/v1/inbound-submissions/:id",
      "summary": "Delete an inbound submission",
      "description": "A hold made from it stays.",
      "auth": "api_key",
      "scope": "booking:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The submission.",
          "example": "9f30c5a1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "7d10a3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "deleted": true
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks booking:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "booking:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"booking:write\""
          }
        },
        {
          "status": 404,
          "description": "No such id in your organization.",
          "example": {
            "error": "not found"
          }
        }
      ]
    },
    {
      "id": "create-inbound-submission-hold",
      "method": "POST",
      "path": "/v1/inbound-submissions/:id/hold",
      "summary": "Hold dates for a submission",
      "description": "Creates a hold (as POST /v1/holds: positions required; title defaults to the artist, notes to the message), marks the submission accepted and links it. Once per submission.",
      "auth": "api_key",
      "scope": "booking:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The submission.",
          "example": "9f30c5a1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "positions",
          "location": "body",
          "type": "array",
          "required": true,
          "description": "The nights, as on POST /v1/holds."
        },
        {
          "name": "title",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Defaults to the artist."
        },
        {
          "name": "notes",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Defaults to the message."
        }
      ],
      "responses": [
        {
          "status": 201,
          "description": "Created.",
          "example": {
            "data": {
              "submission_id": "7d10a3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "hold": {
                "id": "8e20b4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                "title": "The Ramblers",
                "status": "active"
              }
            }
          }
        },
        {
          "status": 409,
          "description": "A hold was already made from it, or a night clashes.",
          "example": {
            "error": "This submission already has a hold"
          }
        },
        {
          "status": 403,
          "description": "The key lacks booking:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "booking:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"booking:write\""
          }
        },
        {
          "status": 404,
          "description": "No such id in your organization.",
          "example": {
            "error": "not found"
          }
        }
      ],
      "request_example": {
        "positions": [
          {
            "date": "2027-03-05",
            "venue_id": "9f30c5a1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
          }
        ]
      }
    }
  ]
}
