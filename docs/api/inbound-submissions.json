    {
      "id": "update-inbound-submission",
      "method": "PATCH",
      "path": "/v1/inbound-submissions/:id",
      "summary": "Review an inbound submission",
      "description": "Set its status and / or a staff note.",
      "auth": "api_key",
      "scope": "booking:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The submission.",
          "example": "9f30c5a1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "status",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "The review status.",
          "enum": [
            "new",
            "reviewing",
            "accepted",
            "declined"
          ],
          "example": "reviewing"
        },
        {
          "name": "staff_note",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "At most 2000 characters, staff only."
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "7d10a3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "status": "reviewing",
              "source": "form",
              "artist_name": "The Ramblers",
              "contact_name": "Jo Agent",
              "contact_role": "agent",
              "email": "jo@agency.example",
