{
  "file": "events",
  "name": "Events",
  "order": 10,
  "description": "The organization's events, their ticket types, add-ons and promo codes. Every route here needs `events:read`.",
  "endpoints": [
    {
      "id": "list-events",
      "method": "GET",
      "path": "/v1/events",
      "summary": "List events",
      "description": "The organization's events, every status, latest start first.",
      "auth": "api_key",
      "scope": "events:read",
      "parameters": [
        {
          "name": "status",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only events in this status.",
          "enum": [
            "draft",
            "published",
            "cancelled"
          ],
          "example": "published"
        },
        {
          "name": "starts_after",
          "location": "query",
          "type": "string (ISO 8601)",
          "required": false,
          "description": "Only events starting at or after this date or time.",
          "example": "2026-12-01"
        },
        {
          "name": "starts_before",
          "location": "query",
          "type": "string (ISO 8601)",
          "required": false,
          "description": "Only events starting before this date or time.",
          "example": "2027-01-01T00:00:00Z"
        },
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
          "example": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 50,
          "description": "Rows per page, 1-200 (default 50).",
          "example": 50
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "9a0c7d3b-1e5f-4a2b-8c6d-0f1e2d3c4b5a",
                "name": "Rooftop Sessions",
                "slug": "rooftop-sessions",
                "status": "draft",
                "starts_at": "2027-01-16T00:00:00+00:00",
                "currency": "USD",
                "tickets_sold": 0,
                "total_tickets": 150,
                "created_at": "2026-10-20T09:41:55.004+00:00"
              },
              {
                "id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
                "name": "Warehouse Night",
                "slug": "warehouse-night",
                "status": "published",
                "starts_at": "2026-12-05T03:00:00+00:00",
                "currency": "USD",
                "tickets_sold": 57,
                "total_tickets": 400,
                "created_at": "2026-10-01T15:12:09.120+00:00"
              }
            ],
            "meta": {
              "page": 1,
              "per_page": 50,
              "total": 2,
              "total_pages": 1
            }
          }
        },
        {
          "status": 400,
          "description": "A bad page, per_page or filter value.",
          "example": {
            "error": "status must be draft, published or cancelled."
          }
        },
        {
          "status": 403,
          "description": "The key lacks events:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "events:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"events:read\""
          }
        }
      ]
    },
    {
      "id": "get-event",
      "method": "GET",
      "path": "/v1/events/:id",
      "summary": "Get an event",
      "description": "One event with its venue and times, and every ticket type (hidden ones included) as `tiers`. `venue_location` is free text as the organizer typed it. `exos_venue_id` / `exos_room_id` link one of the organization's venues and rooms (GET /v1/venues/:id) and `hold_id` the hold a draft was converted from; each is null when not set.",
      "auth": "api_key",
      "scope": "events:read",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event's id. An event of another organization answers 404.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
              "name": "Warehouse Night",
              "slug": "warehouse-night",
              "status": "published",
              "starts_at": "2026-12-05T03:00:00+00:00",
              "doors_at": "2026-12-05T02:30:00+00:00",
              "ends_at": "2026-12-05T08:00:00+00:00",
              "timezone": "America/New_York",
              "currency": "USD",
              "venue_name": "The Loft",
              "venue_location": "120 Morgan Ave, Brooklyn, NY",
              "exos_venue_id": null,
              "exos_room_id": null,
              "hold_id": null,
              "tickets_sold": 57,
              "total_tickets": 400,
              "created_at": "2026-10-01T15:12:09.120+00:00",
              "tiers": [
                {
                  "id": "a3f1c2d4-5b6e-4f70-8a91-b2c3d4e5f601",
                  "name": "Early bird",
                  "description": "",
                  "price": 15,
                  "capacity": 100,
                  "sold": 57,
                  "ticket_type": "paid",
                  "visibility": "public",
                  "sales_start": null,
                  "sales_end": "2026-11-20T05:00:00+00:00",
                  "sort_order": 0
                },
                {
                  "id": "b4e2d3c5-6a7f-4081-9ba2-c3d4e5f60712",
                  "name": "General",
                  "description": "Standing room",
                  "price": 25,
                  "capacity": 300,
                  "sold": 0,
                  "ticket_type": "paid",
                  "visibility": "public",
                  "sales_start": null,
                  "sales_end": null,
                  "sort_order": 1
                }
              ]
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks events:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "events:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"events:read\""
          }
        },
        {
          "status": 404,
          "description": "No such event in the key's organization (or the id is malformed).",
          "example": {
            "error": "event not found"
          }
        }
      ]
    },
    {
      "id": "list-ticket-types",
      "method": "GET",
      "path": "/v1/events/:id/ticket-types",
      "summary": "List an event's ticket types",
      "description": "The event's ticket types (tiers) in display order, hidden ones included. `price` is in the event's currency's major unit (15 = $15.00); `ticket_type` is paid, free or donation. `seated` is true for a ticket type sold as reserved seats (see List an event's seats).",
      "auth": "api_key",
      "scope": "events:read",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event's id. An event of another organization answers 404.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "a3f1c2d4-5b6e-4f70-8a91-b2c3d4e5f601",
                "name": "Early bird",
                "description": "",
                "price": 15,
                "capacity": 100,
                "sold": 57,
                "ticket_type": "paid",
                "visibility": "public",
                "sales_start": null,
                "sales_end": "2026-11-20T05:00:00+00:00",
                "sort_order": 0,
                "seated": false
              },
              {
                "id": "b4e2d3c5-6a7f-4081-9ba2-c3d4e5f60712",
                "name": "General",
                "description": "Standing room",
                "price": 25,
                "capacity": 300,
                "sold": 0,
                "ticket_type": "paid",
                "visibility": "public",
                "sales_start": null,
                "sales_end": null,
                "sort_order": 1,
                "seated": false
              }
            ]
          }
        },
        {
          "status": 403,
          "description": "The key lacks events:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "events:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"events:read\""
          }
        },
        {
          "status": 404,
          "description": "No such event in the key's organization (or the id is malformed).",
          "example": {
            "error": "event not found"
          }
        }
      ]
    },
    {
      "id": "list-add-ons",
      "method": "GET",
      "path": "/v1/events/:id/add-ons",
      "summary": "List an event's add-ons",
      "description": "Extras sold with tickets (parking, merch), in display order. `capacity` 0 means unlimited.",
      "auth": "api_key",
      "scope": "events:read",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event's id. An event of another organization answers 404.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "c5f3e4d6-7b80-4192-8cb3-d4e5f6071823",
                "name": "Parking",
                "description": "Lot B, all night",
                "price": 12,
                "capacity": 80,
                "sold": 21,
                "max_per_order": 2,
                "visibility": "public",
                "sort_order": 0
              }
            ]
          }
        },
        {
          "status": 403,
          "description": "The key lacks events:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "events:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"events:read\""
          }
        },
        {
          "status": 404,
          "description": "No such event in the key's organization (or the id is malformed).",
          "example": {
            "error": "event not found"
          }
        }
      ]
    },
    {
      "id": "list-promo-codes",
      "method": "GET",
      "path": "/v1/events/:id/promo-codes",
      "summary": "List an event's promo codes",
      "description": "The event's promo codes, newest first. A code gives one of `discount_percent`, `discount_amount` (major unit) or `price_override`; `tier_id` null means it applies to any ticket type. `link_*` are the tracked-link fields. The email a code is reserved for is never returned. Add ?code= to look one code up by name.",
      "auth": "api_key",
      "scope": "events:read",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event's id. An event of another organization answers 404.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "code",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only the code with this name, in any case (look a code up by name).",
          "example": "LOFTFAM"
        },
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
          "example": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 50,
          "description": "Rows per page, 1-200 (default 50).",
          "example": 50
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "d6a4f5e7-8c91-42a3-9dc4-e5f607182934",
                "code": "LOFTFAM",
                "tier_id": null,
                "max_uses": 50,
                "used_count": 12,
                "discount_percent": 20,
                "discount_amount": null,
                "price_override": null,
                "valid_until": "2026-12-01T05:00:00+00:00",
                "link_label": "Newsletter",
                "link_channel": "email",
                "link_clicks": 341,
                "created_at": "2026-10-03T18:20:00+00:00"
              }
            ],
            "meta": {
              "page": 1,
              "per_page": 50,
              "total": 1,
              "total_pages": 1
            }
          }
        },
        {
          "status": 400,
          "description": "A bad page, per_page or filter value.",
          "example": {
            "error": "per_page must be between 1 and 200."
          }
        },
        {
          "status": 403,
          "description": "The key lacks events:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "events:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"events:read\""
          }
        },
        {
          "status": 404,
          "description": "No such event in the key's organization (or the id is malformed).",
          "example": {
            "error": "event not found"
          }
        }
      ]
    }
  ]
}
