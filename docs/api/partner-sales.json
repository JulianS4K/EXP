      "id": "public-create-comp",
      "method": "POST",
      "path": "/v1/public/confirms/:id/comps",
      "summary": "Comp tickets",
      "description": "Free tickets, completed in one call. Needs a key with the comps scope.",
      "auth": "partner_key",
      "scope": null,
      "parameters": [
        {
          "name": "shared_key",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Your partner key (dk_live_…). Or send it as the X-Shared-Key header, or as Authorization: Bearer.",
          "example": "dk_live_4f2a…"
        },
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event id (Opendate calls it the confirm id).",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "comp[order_items_attributes]",
          "location": "body",
          "type": "array of object",
          "required": true,
          "description": "1-10 lines of { ticket_type_id, quantity } of types open to you.",
          "example": [
            {
              "ticket_type_id": "8c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
              "quantity": 1
            }
          ]
        },
        {
          "name": "comp[first_name]",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Guest first name.",
          "example": "Sam"
        },
        {
          "name": "comp[last_name]",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Guest last name.",
          "example": "Guest"
        },
        {
          "name": "comp[email]",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Guest email.",
          "example": "sam@example.com"
        },
        {
          "name": "comp[comp_reason]",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Why (at most 200 characters).",
          "example": "Radio giveaway"
        },
        {
          "name": "comp[should_send_ticket_email]",
          "location": "body",
          "type": "boolean",
          "required": false,
          "description": "Email the guest their links.",
