  {
   "id": "list-series-dates",
   "method": "GET",
   "path": "/v1/series/:id/dates",
   "summary": "List a series' dates",
   "description": "The series' schedule, paged, in date order. `status` is `generated` (a date with its event), `cancelled` (its event was cancelled), `skipped` (cancelled before an event was made; never generated) or `removed` (the show was detached and sells on its own).",
   "auth": "api_key",
   "scope": "events:read",
   "parameters": [
    {
     "name": "id",
     "location": "path",
     "type": "string (UUID)",
     "required": true,
     "description": "The series's id. One of another organization answers 404.",
     "example": "6c1d2e3f-4a5b-4c6d-8e7f-90a1b2c3d4e5"
    },
    {
     "name": "page",
     "location": "query",
     "type": "integer",
     "required": false,
     "default": 1,
     "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
     "example": 1
    },
    {
     "name": "per_page",
     "location": "query",
     "type": "integer",
     "required": false,
     "default": 50,
     "description": "Rows per page, 1-200 (default 50).",
     "example": 50
    }
   ],
   "responses": [
    {
     "status": 200,
     "description": "OK.",
     "example": {
      "data": [
       {
        "occ_date": "2026-11-06",
        "occ_time": "20:00:00",
        "starts_at": "2026-11-07T01:00:00+00:00",
