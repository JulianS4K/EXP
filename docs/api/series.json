{
 "file": "series",
 "name": "Series, collections and timed entry",
 "order": 15,
 "description": "Recurring series (each date is an ordinary event), collections (public pages grouping events) and timed entry (ticket types sold by date and time slot, with a capacity per slot). Read only, like the rest of the API: organizers create and change them in the dashboard. Public pages read the same data without a key through the published-only functions listed in docs/series-timed-entry.md.",
 "endpoints": [
  {
   "id": "list-series",
   "method": "GET",
   "path": "/v1/series",
   "summary": "List event series",
   "description": "The organization's recurring series, newest first. Each date of a series is an ordinary event (see Events); `template_event_id` is the event the series copies, and `rule` the recurrence the dashboard expands into dates.",
   "auth": "api_key",
   "scope": "events:read",
   "parameters": [
    {
     "name": "status",
     "location": "query",
     "type": "string",
     "required": false,
     "description": "Only series in this status.",
     "enum": [
      "active",
      "archived",
      "cancelled"
     ],
     "example": "active"
    },
    {
     "name": "page",
     "location": "query",
     "type": "integer",
     "required": false,
     "default": 1,
     "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
     "example": 1
    },
    {
     "name": "per_page",
     "location": "query",
     "type": "integer",
     "required": false,
     "default": 50,
     "description": "Rows per page, 1-200 (default 50).",
     "example": 50
    }
   ],
   "responses": [
    {
     "status": 200,
     "description": "OK.",
     "example": {
      "data": [
       {
        "id": "6c1d2e3f-4a5b-4c6d-8e7f-90a1b2c3d4e5",
        "name": "Jazz Fridays",
        "kind": "recurring",
        "status": "active",
        "description": "Live jazz every Friday.",
        "image_url": "https://cdn.example.com/jazz.png",
        "template_event_id": "9a0c7d3b-1e5f-4a2b-8c6d-0f1e2d3c4b5a",
        "timezone": "America/New_York",
        "rule": {
         "freq": "weekly",
         "interval": 1,
         "weekdays": [
          5
         ],
         "startDate": "2026-11-06",
         "count": 12,
         "time": "20:00",
         "exceptions": [
          "2026-11-27"
         ],
         "overrides": {}
        },
        "created_at": "2026-10-30T15:02:11.410+00:00",
        "updated_at": "2026-10-30T15:10:40.002+00:00",
        "cancelled_at": null
       }
      ],
      "meta": {
       "page": 1,
       "per_page": 50,
       "total": 1,
       "total_pages": 1
      }
     }
    },
    {
     "status": 400,
     "description": "Bad status, page or per_page.",
     "example": {
      "error": "status must be active, archived or cancelled."
     }
    },
    {
     "status": 403,
     "description": "The key lacks events:read.",
     "example": {
      "error": "insufficient scope",
      "required_scope": "events:read"
     },
     "headers": {
      "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"events:read\""
     }
    }
   ]
  },
  {
   "id": "get-series",
   "method": "GET",
   "path": "/v1/series/:id",
   "summary": "Get an event series",
   "description": "One series with `summary_stats` (dates in the series, cancelled dates, tickets sold, gross of fulfilled orders in cents, average share of capacity sold over dates with a capacity) and `schedule`: every date the series generated, cancelled, skipped or had removed, in date order (first 500; page through `/v1/series/:id/dates` for more). `occ_date` and `occ_time` are wall clock in the series' timezone.",
   "auth": "api_key",
   "scope": "events:read",
   "parameters": [
    {
     "name": "id",
     "location": "path",
     "type": "string (UUID)",
     "required": true,
     "description": "The series's id. One of another organization answers 404.",
