        "starts_at": "2026-11-14T01:00:00+00:00",
        "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
        "status": "generated"
       },
       {
        "occ_date": "2026-11-20",
        "occ_time": "20:00:00",
        "starts_at": "2026-11-21T01:00:00+00:00",
        "event_id": null,
        "status": "skipped"
       }
      ],
      "meta": {
       "page": 1,
       "per_page": 50,
       "total": 3,
       "total_pages": 1
      }
     }
