  {
   "id": "get-timed-entry",
   "method": "GET",
   "path": "/v1/events/:id/timed-entry",
   "summary": "Get an event's timed-entry settings",
   "description": "Which ticket types sell a date and time slot, the slot length, places per slot (all timed types together) and optional per-type caps, the entry window (`entry_window_minutes` after the start, null = until the slot ends; `early_entry_minutes` before it), opening hours per weekday (`'0'` = Sunday), the dates sold and closed dates. Slot ids are the wall-clock start, `YYYYMMDDTHHMM`, in the event's timezone.",
   "auth": "api_key",
   "scope": "events:read",
   "parameters": [
    {
     "name": "id",
     "location": "path",
     "type": "string (UUID)",
     "required": true,
     "description": "The event's id. One of another organization answers 404.",
     "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
    }
   ],
   "responses": [
    {
     "status": 200,
     "description": "OK.",
     "example": {
      "data": {
       "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
       "tier_ids": [
        "b4e2d3c5-6a7f-4081-9ba2-c3d4e5f60712"
       ],
       "slot_minutes": 30,
       "capacity": 40,
       "tier_capacity": {
        "b4e2d3c5-6a7f-4081-9ba2-c3d4e5f60712": 30
       },
       "entry_window_minutes": 15,
       "early_entry_minutes": 10,
       "hours": {
        "2": [
         {
          "open": "10:00",
          "close": "17:00"
         }
        ],
        "6": [
         {
          "open": "09:00",
          "close": "13:00"
         },
         {
          "open": "14:00",
          "close": "18:00"
         }
        ]
       },
       "start_date": "2026-11-03",
       "end_date": "2027-02-28",
       "closed_dates": [
        "2026-12-25"
       ],
       "version": 1793370000000,
       "updated_at": "2026-10-30T15:30:00.000+00:00"
      }
     }
    },
    {
     "status": 403,
     "description": "The key lacks events:read.",
     "example": {
      "error": "insufficient scope",
      "required_scope": "events:read"
     },
     "headers": {
      "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"events:read\""
     }
    },
    {
     "status": 404,
     "description": "No such event in the key's organization, or it isn't timed.",
     "example": {
      "error": "this event has no timed entry"
     }
    }
   ]
  },
  {
   "id": "list-slots",
   "method": "GET",
   "path": "/v1/events/:id/slots",
   "summary": "List an event's time slots",
   "description": "The slot report: every scheduled slot between `from` and `to` (default yesterday to 30 days on, at most 62 days) plus any slot with tickets, with capacity (`custom` when staff changed it), closed, sold, live holds, checked in, gross of active tickets and sales per ticket type.",
   "auth": "api_key",
   "scope": "tickets:read",
   "parameters": [
    {
     "name": "id",
     "location": "path",
     "type": "string (UUID)",
     "required": true,
     "description": "The event's id. One of another organization answers 404.",
     "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
    },
    {
     "name": "from",
     "location": "query",
     "type": "string (date)",
     "required": false,
     "description": "First date (YYYY-MM-DD, event timezone).",
     "example": "2026-11-14"
    },
    {
     "name": "to",
     "location": "query",
     "type": "string (date)",
     "required": false,
     "description": "Last date (YYYY-MM-DD); at most 61 days after `from`.",
     "example": "2026-11-15"
    }
   ],
   "responses": [
    {
     "status": 200,
     "description": "OK.",
     "example": {
      "data": [
       {
        "slot_id": "20261114T1030",
        "slot_date": "2026-11-14",
        "slot_time": "10:30",
        "starts_at": "2026-11-14T15:30:00+00:00",
        "capacity": 40,
        "custom": false,
        "closed": false,
        "sold": 31,
        "held": 2,
        "checked_in": 12,
        "gross": 465.0,
        "tier_sold": {
         "b4e2d3c5-6a7f-4081-9ba2-c3d4e5f60712": 31
        }
       }
      ]
     }
    },
    {
     "status": 400,
     "description": "A bad date.",
     "example": {
      "error": "from must be a date (YYYY-MM-DD)."
     }
    },
    {
     "status": 403,
     "description": "The key lacks tickets:read.",
     "example": {
      "error": "insufficient scope",
      "required_scope": "tickets:read"
     },
     "headers": {
      "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"tickets:read\""
     }
    },
    {
     "status": 404,
     "description": "No such event in the key's organization (or the id is malformed).",
     "example": {
      "error": "event not found"
     }
    }
   ]
  }
 ]
