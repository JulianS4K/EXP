{
  "file": "attendance",
  "name": "Attendance report",
  "order": 31.7,
  "description": "Where an event's attendees are, by billing postal area, and how its ticket sales are pacing against another event of the organization. Aggregate only: no row describes one buyer, and a postal area with fewer than 5 buyers is never named.",
  "endpoints": [
    {
      "id": "get-event-attendance",
      "method": "GET",
      "path": "/v1/events/:id/attendance",
      "summary": "An event's attendance report",
      "description": "Two parts. `attendance`: the event's orders (paid, and the $0 orders Exos records for free claims, comps and RSVPs) counted by their live tickets now (active or checked in), grouped by the billing postal code Stripe or PayPal gave at payment (Exos never looks up IP addresses and never stores a street). The code is coarsened first: a US ZIP+4 to the 5-digit ZIP, a Canadian code to its first three characters, a UK postcode to its outward code. An area with at least `min_buyers` (5) distinct buyers is listed in `postal`, most tickets first; every smaller area is folded into `postal_other` (\"Other (fewer than 5)\") and never named. `postal_unknown` is the orders with no postal code (free orders, card payments that carried only a country, orders from before locations were recorded); `other_tickets` counts live tickets with no order (door sales, imports). `pacing`: for this event, and for `compare` when given, one row per day with a sale, in the event's time zone: paid orders and tickets, gross (charged plus any gift card part, in `currency`'s minor unit, before refunds), and $0 orders and tickets counted apart (never in gross), with running totals. `days_before` lines the two events up (sales on or after the event day count on day 0); `on_sale_day` is the earlier of the first ticket type's sales start and the first sale; `days_out_now` is negative once the event has passed. `comparison_candidates` lists the organization's events that started before this one (at most 50, newest first). Who may read it: the scope `orders:read`, and an API key whose creator (or a personal / OAuth token whose user) is an owner, manager or finance member of the organization now. 20 reads a minute per credential.",
      "auth": "api_key",
      "scope": "orders:read",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event's id. An event of another organization answers 404.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "compare",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Another event of the organization to pace against (usually last year's edition). Also accepted as `compare_event_id`. An event of another organization answers 404.",
          "example": "9c2d4e6f-1a3b-4c5d-8e7f-0a1b2c3d4e5f"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
