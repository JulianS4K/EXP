      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "7c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
                "last4": "NPQ9",
                "currency": "usd",
                "initial_cents": 5000,
                "balance_cents": 1500,
                "status": "active",
                "source": "box_office",
                "payment_method": "cash",
                "product_id": "2b3c4d5e-6f70-4182-93a4-b5c6d7e8f901",
                "recipient_email": "ann@example.com",
                "issued_by": "2b3c4d5e-6f70-4182-93a4-b5c6d7e8f901",
                "pos_drawer_id": null,
                "expires_at": null,
                "created_at": "2026-10-30T12:00:00+00:00"
              }
            ],
            "meta": {
              "page": 1,
              "per_page": 50,
              "total": 1,
