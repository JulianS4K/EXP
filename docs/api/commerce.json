{
  "file": "commerce",
  "name": "Gift cards, giving, memberships and passes",
  "order": 40,
  "description": "Gift cards (products, issued cards and their ledgers), giving campaigns and donations, membership products and members, season passes and flex packs, and member presales. Every route here needs `commerce:read`. Amounts ending in `_cents` are integers in the currency's minor unit. Creating these (selling a gift card at the box office, recording a cash gift, gifting a membership) is done in Org settings for now.",
  "endpoints": [
    {
      "id": "list-gift-card-products",
      "method": "GET",
      "path": "/v1/gift-card-products",
      "summary": "List gift card products",
      "description": "What the organization sells as gift cards: fixed amounts or an open range, in minor units.",
      "auth": "api_key",
      "scope": "commerce:read",
      "parameters": [],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "7c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
                "name": "Holiday gift card",
                "description": null,
                "currency": "usd",
                "amount_type": "fixed",
                "amounts_cents": [
                  2500,
                  5000,
                  10000
                ],
                "min_cents": null,
                "max_cents": null,
                "image_url": null,
                "expiry_months": null,
                "active": true,
                "created_at": "2026-10-30T12:00:00+00:00"
              }
            ]
          }
        },
        {
          "status": 403,
          "description": "The key lacks commerce:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "commerce:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"commerce:read\""
          }
        }
      ]
    },
    {
      "id": "list-gift-cards",
      "method": "GET",
      "path": "/v1/gift-cards",
      "summary": "List gift cards",
      "description": "Issued gift cards, newest first. Only the last 4 characters of a code: the code itself is never stored. `source` is online, box_office, api or dashboard; `issued_by` and `pos_drawer_id` reconcile box-office sales against the till.",
      "auth": "api_key",
      "scope": "commerce:read",
      "parameters": [
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
          "example": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 50,
          "description": "Rows per page, 1-200 (default 50).",
          "example": 50
