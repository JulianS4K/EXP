    {
      "id": "create-offer-pool",
      "method": "POST",
      "path": "/v1/offer-pools",
      "summary": "Create (or get) an offer pool",
      "description": "The pool over a budget (pass a budget_id, or an offer_id of an offer on it): one per budget, so asking again returns the same pool. In `pool` mode the pool's terms make one payout for the lineup (its support costs are the guarantees of the acts outside it, then its floor and cap), split by each member offer's pool_share_percent; members without a share split what is left equally. In `independent` mode each act keeps its own deal.",
      "auth": "api_key",
      "scope": "booking:write",
      "parameters": [
        {
          "name": "offer_id",
          "location": "body",
          "type": "string (UUID)",
          "required": false,
          "description": "An offer on the budget (Opendate: v3_offer_id).",
          "example": "7d10a3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "budget_id",
          "location": "body",
          "type": "string (UUID)",
          "required": false,
          "description": "The budget.",
          "example": "a040d6b1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "mode",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Default independent.",
          "enum": [
            "independent",
            "pool"
          ],
          "example": "pool"
        },
        {
          "name": "terms",
          "location": "body",
          "type": "object",
          "required": false,
          "description": "The shared deal: { deal_type, guarantee_cents, percentage, expenses_cap_cents, promoter_profit_percent, payout_cap_cents, payout_floor_cents }.",
          "example": {
            "deal_type": "versus",
            "guarantee_cents": 300000,
            "percentage": 80,
            "expenses_cap_cents": null,
            "promoter_profit_percent": 0,
            "payout_cap_cents": 800000,
            "payout_floor_cents": null
          }
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "7d10a3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "budget_id": "a040d6b1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "mode": "pool",
              "terms": {
                "deal_type": "versus",
                "guarantee_cents": 300000,
                "percentage": 80,
                "expenses_cap_cents": null,
                "promoter_profit_percent": 0,
                "payout_cap_cents": 800000,
                "payout_floor_cents": null
              },
              "offer_ids": [
                "7d10a3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                "8e20b4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
              ],
              "created_at": "2026-10-31T15:04:05.120+00:00",
              "updated_at": "2026-10-31T15:04:05.120+00:00"
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks booking:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "booking:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"booking:write\""
          }
