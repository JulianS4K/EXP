{
  "file": "budgets",
  "name": "Budgets and offer pools",
  "order": 64,
  "description": "Every offer sits on a budget (Opendate's v3 budgets): capacity, average price, sell-through and income and expense lines in your finance categories. Offers that share a budget are a lineup; an offer pool over the budget can pay the lineup from one shared deal. Bonuses and deposits are part of each offer's terms (PATCH /v1/offers/:id). Money is in cents. Reads need `booking:read`, writes `booking:write`.",
  "endpoints": [
    {
      "id": "list-budgets",
      "method": "GET",
      "path": "/v1/budgets",
      "summary": "List budgets",
      "description": "Newest first.",
      "auth": "api_key",
      "scope": "booking:read",
      "parameters": [
        {
          "name": "event_id",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Only budgets for this show.",
          "example": "9f30c5a1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "hold_id",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Only budgets made from this hold.",
          "example": "8e20b4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "venue_id",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Only budgets at this venue.",
          "example": "8e20b4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
          "default": 1,
          "example": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "description": "Rows per page, 1-200 (default 50).",
          "default": 50,
          "example": 50
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "a040d6b1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                "name": "The Headliners at Metro",
                "currency": "USD",
                "venue_id": "8e20b4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                "hold_id": "8e20b4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                "event_id": null,
                "capacity": 500,
                "average_price_cents": 2500,
                "sell_through_percent": 80,
                "notes": "",
                "created_at": "2026-10-31T15:04:05.120+00:00",
                "updated_at": "2026-10-31T15:04:05.120+00:00"
              }
            ],
            "meta": {
              "page": 1,
              "per_page": 50,
              "total": 1,
              "total_pages": 1
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks booking:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "booking:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"booking:read\""
          }
        }
      ]
    },
