          "type": "string",
          "required": false,
          "description": "1-150 characters.",
          "example": "Night one"
        },
        {
          "name": "capacity",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "0-1,000,000.",
          "example": 500
        },
        {
          "name": "average_price_cents",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Average ticket price.",
          "example": 2500
        },
        {
          "name": "sell_through_percent",
          "location": "body",
          "type": "number",
          "required": false,
          "description": "0-100.",
          "example": 80
        },
        {
          "name": "notes",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Up to 2,000 characters.",
          "example": ""
        },
        {
          "name": "venue_id",
          "location": "body",
          "type": "string (UUID) or null",
          "required": false,
          "description": "One of your venues.",
          "example": "8e20b4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "event_id",
          "location": "body",
          "type": "string (UUID) or null",
          "required": false,
          "description": "The show."
