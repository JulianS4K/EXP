{
  "file": "holds",
  "name": "Holds and calendar",
  "order": 61,
  "description": "Holds pencil nights at a venue before a show is confirmed. Each night (a position) sits at a level in its line: the organization's holds on that room (or the whole venue) that date, 1 first. Levels are always 1..N: clearing or converting a night moves the ones behind it up. Lines only ever count your organization's holds, even on a rented or partner venue. Every change sends hold.created, hold.updated or hold.converted webhooks, and hold.updated (reason level_changed) to each other hold whose level moved. Reads need `booking:read`, writes `booking:write`.",
  "endpoints": [
    {
      "id": "list-holds",
      "method": "GET",
      "path": "/v1/holds",
      "summary": "List holds",
      "description": "Holds by first night, with every night (cleared and converted ones included). The date, venue and room filters match a hold with any night that fits.",
      "auth": "api_key",
      "scope": "booking:read",
      "parameters": [
        {
          "name": "from",
          "location": "query",
          "type": "string (date)",
          "required": false,
          "description": "Only holds with a night on or after this date.",
          "example": "2026-11-01"
        },
        {
          "name": "to",
          "location": "query",
          "type": "string (date)",
          "required": false,
          "description": "Only holds with a night on or before this date.",
          "example": "2026-11-30"
        },
        {
          "name": "venue_id",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Only holds with a night at this venue (also `q[venue_id_eq]`).",
          "example": "7a10c3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "room_id",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Only holds with a night in this room.",
          "example": "5b20d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "status",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "active (any night still held), cleared (every night released) or converted (a night became an event, none held).",
          "enum": [
            "active",
            "cleared",
            "converted"
          ],
          "example": "active"
        },
        {
          "name": "q",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only holds whose title contains this (also `title`).",
          "example": "band"
        },
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
          "example": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 50,
          "description": "Rows per page, 1-200 (default 50).",
          "example": 50
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "4c30e5a1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                "title": "Band A",
                "notes": "Agent wants an answer by Friday.",
                "status": "active",
                "artist_ids": [],
                "announce_at": "2026-09-01T15:00:00+00:00",
                "ticket_forecast": 400,
                "age_restriction": "21+",
                "rental": null,
                "first_date": "2026-11-14",
                "last_date": "2026-11-15",
                "created_via": "api",
                "cleared_at": null,
                "converted_at": null,
                "created_at": "2026-10-29T15:04:05.120+00:00",
                "updated_at": "2026-10-29T15:04:05.120+00:00",
                "positions": [
                  {
                    "id": "3d40f6b1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                    "date": "2026-11-14",
                    "venue_id": "7a10c3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                    "room_id": "5b20d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                    "start_time": "20:00",
                    "is_target": true,
                    "level": 1,
                    "status": "active",
                    "event_id": null,
                    "cleared_at": null,
                    "converted_at": null
                  },
                  {
                    "id": "3d40f6b2-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                    "date": "2026-11-15",
                    "venue_id": "7a10c3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                    "room_id": "5b20d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                    "start_time": "20:00",
                    "is_target": false,
                    "level": 2,
                    "status": "active",
                    "event_id": null,
                    "cleared_at": null,
                    "converted_at": null
                  }
                ]
              }
            ],
            "meta": {
              "page": 1,
              "per_page": 50,
              "total": 1,
              "total_pages": 1
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks booking:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "booking:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"booking:read\""
          }
        },
        {
          "status": 400,
          "description": "A field is missing or invalid; the message names it.",
          "example": {
            "error": "from must be a date written YYYY-MM-DD."
          }
        }
      ]
    },
    {
      "id": "create-hold",
      "method": "POST",
      "path": "/v1/holds",
      "summary": "Create a hold",
      "description": "Holds one or more nights. Each goes to the end of its line unless a level is asked for.",
      "auth": "api_key",
      "scope": "booking:write",
      "parameters": [
        {
          "name": "title",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "Up to 100 characters.",
          "example": "Band A"
        },
        {
          "name": "positions",
          "location": "body",
          "type": "array of objects",
          "required": true,
          "description": "The nights held, 1-30: each { date (YYYY-MM-DD, the venue's local date), venue_id, room_id (or null for the whole venue), level (1-50; left out = the end of the line), start_time (HH:MM, venue-local; the default show time when converted), is_target (true / false) }. A hold holds a room on a date once. Asking for a level that is taken moves the holds at or below it down one.",
          "example": [
            {
              "date": "2026-11-14",
              "venue_id": "7a10c3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "room_id": "5b20d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "start_time": "20:00",
              "is_target": true
            },
            {
              "date": "2026-11-15",
              "venue_id": "7a10c3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "room_id": "5b20d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
            }
          ]
        },
        {
          "name": "notes",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Up to 2000 characters. Carried to the event as a staff note when a night converts.",
          "example": "Agent wants an answer by Friday."
        },
        {
          "name": "announce_at",
          "location": "body",
          "type": "string (ISO 8601) or null",
          "required": false,
          "description": "When the show is announced. A time still ahead when a night converts becomes the event's Announce row.",
          "example": "2026-09-01T15:00:00Z"
        },
        {
          "name": "ticket_forecast",
          "location": "body",
          "type": "integer or null",
          "required": false,
          "description": "Expected tickets, 0-1,000,000.",
          "example": 400
        },
        {
          "name": "age_restriction",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "A label, up to 40 characters.",
          "example": "21+"
        },
        {
          "name": "artist_ids",
          "location": "body",
          "type": "array of strings (UUID)",
          "required": false,
          "description": "Up to 20 artist ids (stored; artists arrive with the artists API).",
          "example": []
        },
        {
          "name": "rental",
          "location": "body",
          "type": "object or null",
          "required": false,
          "description": "Rental terms when you rent the room: { status: requested | confirmed | declined, fee, deposit (major units), currency (ISO 4217, default USD), notes }.",
          "example": {
            "status": "requested",
            "fee": 2500,
            "deposit": 500,
            "currency": "USD",
            "notes": "Bar split TBD"
          }
        }
      ],
      "responses": [
        {
          "status": 201,
          "description": "Created.",
          "example": {
            "data": {
              "id": "4c30e5a1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "title": "Band A",
              "notes": "Agent wants an answer by Friday.",
