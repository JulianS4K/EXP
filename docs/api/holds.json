      "id": "convert-hold",
      "method": "POST",
      "path": "/v1/holds/:id/convert-to-event",
      "summary": "Convert a night into an event",
      "description": "Makes one active night a draft event, in one step: the event takes the hold's title, the venue's address and time zone, starts at the night's time in that zone, links the venue, room and hold, and gets one free General Admission ticket type sized to the room (else the venue, else 100). An announce time still ahead becomes its Announce schedule row and the hold's notes its first staff note. The night is marked converted; the hold's other rooms that night are cleared; the holds behind it move up. The hold's other dates stay held. Also at /v1/holds/:id/convert_to_event and /v1/holds/:id/convert_to_confirm.",
      "auth": "api_key",
      "scope": "booking:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The hold's id. One of another organization answers 404.",
          "example": "4c30e5a1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "position_id",
          "location": "body",
          "type": "string (UUID)",
          "required": false,
          "description": "The night (also `hold_position_id`). Or send date (and room_id when the hold has several rooms that date).",
          "example": "3d40f6b1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "date",
          "location": "body",
          "type": "string (date)",
          "required": false,
          "description": "The night's date, instead of position_id.",
          "example": "2026-11-14"
        },
        {
          "name": "room_id",
          "location": "body",
          "type": "string (UUID)",
          "required": false,
          "description": "With date: which room.",
          "example": "5b20d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "time",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Start, HH:MM in the venue's time zone (default the night's start_time, else 20:00).",
          "example": "20:00"
        },
        {
          "name": "title",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "The event's name (default the hold's title).",
          "example": "Band A"
        },
        {
          "name": "capacity",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "The ticket type's size, 1-1,000,000.",
          "example": 450
        },
        {
          "name": "clear_holds_on_day",
          "location": "body",
          "type": "boolean",
          "required": false,
          "description": "Also clear every other hold's night at this venue that date, in every room (default false).",
          "example": false
