    {
      "id": "clear-hold",
      "method": "POST",
      "path": "/v1/holds/:id/clear",
      "summary": "Clear nights",
      "description": "Releases the nights named, or every active night. A cleared night stays on the hold with cleared_at; the holds behind it move up (level 2 becomes 1). Naming a night that is already cleared changes nothing.",
