    {
      "id": "delete-deal",
      "method": "DELETE",
      "path": "/v1/deals/:id",
      "summary": "Discard a deal",
      "description": "Soft: it stays readable with include_discarded.",
      "auth": "api_key",
      "scope": "booking:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The deal id.",
          "example": "7d10a3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "7d10a3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "discarded": true
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks booking:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "booking:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"booking:write\""
          }
        },
        {
          "status": 404,
