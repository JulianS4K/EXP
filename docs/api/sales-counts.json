{
  "file": "sales-counts",
  "name": "Sales counts",
  "order": 35,
  "description": "Tickets an organization sold somewhere other than Exos: a box office, a consignment, or another platform (DICE, Resident Advisor, Posh, Shotgun, Ticketmaster…). Each event keeps up to 20 entries, one per manual label or imported platform. An entry is counts and amounts only, never buyer data, and is never added to Exos's own orders, revenue or check-ins; reports show it beside them. Amounts are integers in minor units of the entry's currency. Reads need `finance:read`; creating, changing, deleting and importing need `finance:write`. These are the first routes that change data: they touch sales counts only. The public event pages show only the total sold elsewhere for a published event, never the entries.",
  "endpoints": [
    {
      "id": "list-sales-counts",
      "method": "GET",
      "path": "/v1/sales-counts",
      "summary": "List sales counts",
      "description": "Every entry of the organization's events, most recently changed first. `available` is capacity − sold when a capacity is known, else null.",
      "auth": "api_key",
      "scope": "finance:read",
      "parameters": [
        {
          "name": "event_id",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Only this event's entries.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "kind",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only typed-in counts (manual) or file imports (import).",
          "example": "manual",
          "enum": [
            "manual",
            "import"
          ]
        },
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
          "example": 1,
          "default": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "description": "Rows per page, 1-200 (default 50).",
          "example": 50,
          "default": 50
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "7d1e4c2a-0b9f-4e3d-8a6c-5f2b1e0d9c84",
                "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
