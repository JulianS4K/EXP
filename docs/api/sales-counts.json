    {
      "id": "import-sales-counts",
      "method": "POST",
      "path": "/v1/events/:id/sales-counts/import",
      "summary": "Import a platform's sales from a CSV",
      "description": "Reads another platform's sales export for this event and stores it as that platform's entry, summed per ticket type. Rows are added up, so a file with one row per ticket type and one with one row per order both work; rows whose status column says refunded, cancelled, void or failed are left out. Importing again replaces the platform's entry instead of adding to it, so the same file twice changes nothing (`status: unchanged`). Columns are matched from the headers; `mapping` overrides any of them. With any error nothing is written (422, each error with its line and field). `dry_run: true` answers the same summary without writing. JSON body; the CSV text is at most 2 MB and 2,000 rows.",
      "auth": "api_key",
      "scope": "finance:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event's id. An event of another organization answers 404.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "platform",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "Where the file comes from.",
          "example": "dice",
          "enum": [
            "eventbrite",
            "dice",
            "ra",
            "posh",
            "shotgun",
            "ticketmaster",
            "axs",
            "seetickets",
            "tixr",
            "etix",
            "partiful",
            "luma",
            "other"
          ]
        },
        {
          "name": "csv",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "The file's text (comma, semicolon or tab separated; the first line is the header). Send this or rows.",
          "example": "Ticket Type,Tickets Sold,Gross\nEarly,50,1000.00\nGA,30,900.00"
        },
        {
          "name": "rows",
          "location": "body",
          "type": "array",
          "required": false,
          "description": "Instead of csv: objects keyed by column header, or arrays whose first is the header.",
          "example": [
            {
              "Ticket Type": "Early",
              "Tickets Sold": 50,
              "Gross": "1000.00"
            }
          ]
        },
        {
          "name": "mapping",
          "location": "body",
          "type": "object",
          "required": false,
          "description": "Field → column header, for any column the headers don't name clearly; null unmaps one. Fields: tier, sold (required), gross (total), price (each; gross = price × sold when there is no gross), capacity, currency, event, status.",
          "example": {
            "sold": "Qty",
            "gross": "Total paid"
          }
        },
        {
          "name": "event",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "When the file covers several events: the value of the event column whose rows belong to this event (any case).",
          "example": "Warehouse Party"
        },
        {
          "name": "currency",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "The amounts' currency when there is no currency column (default: the event's). A file mixing currencies is refused.",
          "example": "USD"
        },
        {
          "name": "file_name",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Shown with the entry, up to 200 characters.",
          "example": "dice-sales.csv"
        },
        {
          "name": "dry_run",
          "location": "body",
          "type": "boolean",
          "required": false,
          "description": "true: check the file and answer what would be imported, writing nothing.",
          "example": false
        }
      ],
      "request_example": {
        "platform": "dice",
        "csv": "Ticket Type,Tickets Sold,Gross,Capacity\nEarly,50,1000.00,50\nGA,30,900.00,150",
        "file_name": "dice-sales.csv"
      },
      "responses": [
        {
          "status": 201,
          "description": "The platform's entry was created (200 when it replaced an earlier import, with status updated or unchanged).",
          "example": {
            "data": {
              "id": "c2a9e7f1-3d5b-4c8a-9e0f-1b2d3c4e5f60",
              "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
              "kind": "import",
              "platform": "dice",
              "label": "DICE",
              "sold": 80,
              "gross_cents": 190000,
              "currency": "USD",
              "capacity": 200,
              "tiers": [
                {
                  "name": "Early",
                  "sold": 50,
                  "gross_cents": 100000,
                  "capacity": 50
                },
                {
                  "name": "GA",
                  "sold": 30,
                  "gross_cents": 90000,
                  "capacity": 150
                }
              ],
              "note": null,
              "file_name": "dice-sales.csv",
              "row_count": 31,
              "created_at": "2026-11-10T15:00:00.000+00:00",
              "updated_at": "2026-11-12T09:30:12.400+00:00",
              "available": 120
            },
            "status": "created",
            "import": {
              "platform": "dice",
              "currency": "USD",
              "sold": 80,
              "gross_cents": 190000,
              "capacity": 200,
              "tiers": [
                {
                  "name": "Early",
                  "sold": 50,
                  "gross_cents": 100000,
                  "capacity": 50
                },
                {
                  "name": "GA",
                  "sold": 30,
                  "gross_cents": 90000,
                  "capacity": 150
                }
              ],
              "rows": 2,
              "other_event_rows": 0,
              "voided_rows": 0,
              "mapping": {
                "tier": "Ticket Type",
                "sold": "Tickets Sold",
                "gross": "Gross",
                "capacity": "Capacity"
              },
              "warnings": []
            }
          }
        },
        {
          "status": 400,
          "description": "No platform, no file, a bad mapping, or the event already has 20 entries.",
          "example": {
            "error": "mapping.sold: column \"Qty\" is not in the file."
          }
        },
        {
          "status": 403,
          "description": "The key lacks finance:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "finance:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"finance:write\""
          }
        },
        {
          "status": 404,
          "description": "No such event in the key's organization.",
          "example": {
            "error": "event not found"
          }
        },
        {
          "status": 413,
          "description": "The body or the CSV is too large.",
          "example": {
