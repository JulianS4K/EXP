    {
      "id": "create-sales-count",
      "method": "POST",
      "path": "/v1/sales-counts",
      "summary": "Add a manual sales count",
      "description": "Records tickets sold outside Exos for one of the organization's events. Saving a label the event already has replaces that count (200, or 200 with the same values when nothing changed); a new label answers 201. An event keeps at most 20 entries. Send a JSON body.",
      "auth": "api_key",
      "scope": "finance:write",
      "parameters": [
        {
          "name": "event_id",
          "location": "body",
          "type": "string (UUID)",
          "required": true,
          "description": "The event, which must belong to the key's organization.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "label",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "Where the tickets were sold, 1-40 characters (\"Box office\", \"Consignment\", a platform without an export). An event has one count per label, case-insensitively: sending a label it already has replaces that count.",
          "example": "Box office"
        },
        {
          "name": "sold",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "Tickets sold there, 0-10,000,000.",
          "example": 12
        },
        {
          "name": "gross_cents",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "What those tickets brought in, in minor units of currency (24000 = $240.00). Default 0.",
          "example": 24000
        },
        {
          "name": "price_cents",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Instead of gross_cents: the price of one ticket; gross_cents becomes price_cents × sold.",
          "example": 2000
        },
        {
          "name": "currency",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "3-letter code. Default: the event's currency. Totals are never added across currencies.",
          "example": "USD"
        },
        {
          "name": "capacity",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Tickets that channel had to sell.",
          "example": 50
        },
        {
          "name": "available",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Instead of capacity: tickets still unsold there; capacity becomes sold + available.",
          "example": 38
        },
        {
          "name": "note",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Up to 200 characters, for staff.",
          "example": "Cash, Friday"
        },
        {
          "name": "tiers",
          "location": "body",
          "type": "array",
          "required": false,
          "description": "Optional per ticket type: [{ name, sold, gross_cents, capacity }], at most 50; lines with the same name (any case) are added up. When given, sold and gross_cents are their sums.",
          "example": []
        }
      ],
      "request_example": {
        "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
        "label": "Box office",
        "sold": 12,
        "gross_cents": 24000,
        "currency": "USD",
        "capacity": 50,
        "note": "Cash, Friday"
      },
      "responses": [
        {
          "status": 201,
          "description": "Created.",
          "example": {
            "data": {
              "id": "7d1e4c2a-0b9f-4e3d-8a6c-5f2b1e0d9c84",
              "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
              "kind": "manual",
              "platform": null,
              "label": "Box office",
              "sold": 12,
              "gross_cents": 24000,
              "currency": "USD",
              "capacity": 50,
              "tiers": [],
              "note": "Cash, Friday",
              "file_name": null,
              "row_count": null,
              "created_at": "2026-11-13T22:10:04.511+00:00",
              "updated_at": "2026-11-14T01:02:44.090+00:00",
              "available": 38
            }
          }
        },
        {
          "status": 200,
          "description": "A count with that label existed and was replaced (or already had these values)."
        },
        {
          "status": 400,
          "description": "A missing or invalid field, or the event already has 20 entries.",
          "example": {
            "error": "a label (where these tickets were sold) of 1-40 characters is required"
          }
        },
        {
          "status": 403,
          "description": "The key lacks finance:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "finance:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"finance:write\""
          }
        },
        {
          "status": 404,
          "description": "No such event in the key's organization.",
          "example": {
            "error": "event not found"
          }
        },
        {
          "status": 415,
          "description": "The body is not JSON.",
          "example": {
            "error": "send a JSON body (Content-Type: application/json)."
          }
        }
      ]
    },
