{
 "file": "org-writes",
 "name": "Organization writes: series, fee rules, API keys and more",
 "order": 62.5,
 "description": "Writes the dashboard had and the API didn't: event series, an event's fee rules (Opendate organizer fee components), the organization's API keys, releasing orphaned seats, importing attendees, membership scans and gifts, cancelling a membership, gift card quotes and issue, offline donations. Each needs an organization API key (sk_live_…) whose creator holds the role named on the route now, and the scope as the key carries it now (a role the owner narrowed applies at once). A write runs as that member through the dashboard's own SQL, is pinned to the key's organization and is logged; an Idempotency-Key makes it safe to resend.",
 "endpoints": [
  {
   "id": "list-api-keys",
   "method": "GET",
   "path": "/v1/api-keys",
   "summary": "List API keys",
   "description": "The organization's API keys, newest first: name, prefix, scopes as stored, last use, revoked. Never a key or its hash. Opendate GET /admin/teams/{team_id}/api_keys.",
   "auth": "api_key",
   "scope": "org:admin",
   "parameters": [],
   "responses": [
    {
     "status": 200,
     "description": "OK.",
     "example": {
      "data": [
       {
        "id": "6b6b6b6b-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
        "name": "CRM sync",
        "key_prefix": "sk_live_3f9a1c2d",
        "scopes": [
         "orders:read"
        ],
        "last_used_at": null,
        "revoked_at": null,
        "created_at": "2026-11-01T12:00:00+00:00"
       }
      ]
     }
    },
    {
     "status": 403,
     "description": "The credential lacks org:admin.",
     "example": {
      "error": "insufficient scope",
      "required_scope": "org:admin"
     },
     "headers": {
      "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
     }
    }
   ]
  },
  {
   "id": "create-api-key",
   "method": "POST",
   "path": "/v1/api-keys",
   "summary": "Create an API key",
   "description": "Mints a key for this organization with at most the scopes of the key that makes it (never a user scope, never above the creator's role's set). The key is answered once and never logged; an Idempotency-Key replay answers without it. Opendate POST /admin/teams/{team_id}/api_keys. Needs an organization API key whose creator is an organization owner now.",
   "auth": "api_key",
   "scope": "org:admin",
   "parameters": [
    {
     "name": "name",
     "location": "body",
     "type": "string",
     "required": false,
     "description": "At most 80 characters.",
     "example": "CRM sync"
    },
    {
     "name": "scopes",
     "location": "body",
     "type": "array of string",
     "required": true,
     "description": "Scope names.",
     "example": [
      "orders:read"
     ]
    },
    {
     "name": "Idempotency-Key",
     "location": "header",
     "type": "string",
     "required": false,
     "description": "8-100 letters, digits, _ . : or -. Resending the same request with the same key returns the first answer.",
     "example": "req-2026-11-05-a"
    }
   ],
   "responses": [
    {
     "status": 201,
     "description": "Created.",
     "example": {
      "data": {
       "id": "6b6b6b6b-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
       "name": "CRM sync",
       "key_prefix": "sk_live_3f9a1c2d",
       "scopes": [
        "orders:read"
       ],
       "created_at": "2026-11-05T12:00:00+00:00",
       "key": "sk_live_3f9a1c2d…"
      }
     }
    },
    {
     "status": 403,
     "description": "The credential lacks org:admin.",
     "example": {
      "error": "insufficient scope",
      "required_scope": "org:admin"
     },
     "headers": {
      "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
     }
    }
   ],
   "request_example": {
    "name": "CRM sync",
    "scopes": [
     "orders:read"
    ]
   }
  },
  {
   "id": "revoke-api-key",
   "method": "DELETE",
   "path": "/v1/api-keys/:id",
   "summary": "Revoke an API key",
   "description": "Revokes one of the organization's keys at once. Opendate DELETE /admin/teams/{team_id}/api_keys/{id}. Needs an organization API key whose creator is an organization owner now.",
