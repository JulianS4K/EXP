       "revoked": true
      }
     }
    },
    {
     "status": 403,
     "description": "The credential lacks org:admin.",
     "example": {
      "error": "insufficient scope",
      "required_scope": "org:admin"
     },
     "headers": {
      "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
     }
    }
   ]
  },
  {
   "id": "create-series",
   "method": "POST",
   "path": "/v1/series",
   "summary": "Create a series",
   "description": "A recurring series from one of your events as its template, with a rule (freq weekly / monthly / custom, startDate, time, …) as in the dashboard. Opendate POST /admin/event_series. Needs an organization API key whose creator is an organization owner or manager now.",
   "auth": "api_key",
   "scope": "events:write",
   "parameters": [
    {
     "name": "template_event_id",
     "location": "body",
     "type": "string (UUID)",
     "required": true,
     "description": "The template event (event_id is accepted too).",
     "example": "2b30d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
    },
    {
     "name": "name",
     "location": "body",
     "type": "string",
     "required": true,
     "description": "The series name.",
     "example": "Jazz Fridays"
    },
    {
     "name": "rule",
     "location": "body",
     "type": "object",
     "required": true,
     "description": "The recurrence rule.",
     "example": {
      "freq": "weekly",
      "startDate": "2026-12-04",
      "time": "20:00"
     }
    },
    {
     "name": "description",
     "location": "body",
     "type": "string",
     "required": false,
     "description": "Shown on the series page.",
     "example": "Every Friday."
    },
    {
     "name": "Idempotency-Key",
     "location": "header",
     "type": "string",
     "required": false,
     "description": "8-100 letters, digits, _ . : or -. Resending the same request with the same key returns the first answer.",
     "example": "req-2026-11-05-a"
    }
   ],
   "responses": [
    {
     "status": 201,
     "description": "Created.",
     "example": {
      "data": {
       "id": "5e1e5e1e-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
       "org_id": "3c40e5a1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
       "name": "Jazz Fridays",
       "template_event_id": "2b30d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
       "rule": {
        "freq": "weekly",
        "startDate": "2026-12-04",
        "time": "20:00"
       },
       "status": "active"
      }
     }
    },
    {
     "status": 403,
     "description": "The credential lacks events:write.",
     "example": {
      "error": "insufficient scope",
      "required_scope": "events:write"
     },
     "headers": {
      "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"events:write\""
     }
    }
   ],
   "request_example": {
    "template_event_id": "2b30d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
    "name": "Jazz Fridays",
    "rule": {
     "freq": "weekly",
     "startDate": "2026-12-04",
     "time": "20:00"
    }
   }
  },
