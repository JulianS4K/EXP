     "location": "body",
     "type": "string",
     "required": false,
     "description": "series_only (default), all_shows or selected.",
     "example": "series_only"
    },
    {
     "name": "event_ids",
     "location": "body",
     "type": "array of string (UUID)",
     "required": false,
     "description": "With selected: the dates to cancel.",
     "example": [
      "2b30d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
     ]
    },
    {
     "name": "reason",
     "location": "body",
     "type": "string",
     "required": false,
     "description": "At most 500 characters.",
     "example": "Venue closed"
