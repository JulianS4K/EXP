{
  "file": "fans",
  "name": "Fans",
  "order": 35,
  "description": "Fan profiles: one per person (email) who bought from the organization, signed up through one of its signup forms, or was added by hand. Built automatically from orders and signups. Personal data is kept minimal (email, an optional name, whether there is an Exos account). Consent is shown on the profile but can't be changed through the API or the dashboard: fans join and leave lists themselves (double opt-in signup forms, the ticket page, unsubscribe links). Reads need `fans:read`, changes `fans:write`. A fan's tags are under Tags.",
  "endpoints": [
    {
      "id": "list-fans",
      "method": "GET",
      "path": "/v1/fans",
      "summary": "List fans",
      "description": "The organization's fans, newest first by default. `email_list` is subscribed, pending (a confirm mail is out), unsubscribed or none.",
      "auth": "api_key",
      "scope": "fans:read",
      "parameters": [
        {
          "name": "q",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Matches email or name, case-insensitive, anywhere in it (at most 100 characters). q[email_cont] and q[first_name_cont] are accepted too.",
          "example": "dana"
        },
        {
          "name": "email",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only the fan with exactly this email (any case).",
          "example": "dana@example.com"
        },
        {
          "name": "tag_id",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Only fans with this tag.",
          "example": "5a7c9e1b-2d4f-4a6c-8e0b-1d3f5a7c9e2b"
        },
        {
          "name": "updated_after",
          "location": "query",
          "type": "string (ISO 8601)",
          "required": false,
          "description": "Only fans changed after this time; with order_by=updated_at for incremental sync.",
          "example": "2026-10-01T00:00:00Z"
        },
        {
          "name": "order_by",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Sort column.",
          "enum": [
            "created_at",
            "updated_at",
            "last_order_at",
            "email"
          ],
          "default": "created_at",
          "example": "updated_at"
        },
        {
          "name": "order",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Sort direction.",
          "enum": [
            "asc",
            "desc"
          ],
          "default": "desc",
          "example": "asc"
        },
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
          "default": 1,
          "example": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "description": "Rows per page, 1-200 (default 50).",
          "default": 50,
          "example": 50
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "7b1e4c2a-3d5f-4a6b-8c9d-0e1f2a3b4c5d",
                "email": "dana@example.com",
                "first_name": "Dana",
                "last_name": "Lee",
                "has_account": true,
                "source": "order",
                "orders_count": 3,
                "first_order_at": "2026-06-01T20:11:00+00:00",
                "last_order_at": "2026-10-04T14:01:02+00:00",
                "email_list": "subscribed",
                "tags": [
                  {
                    "id": "5a7c9e1b-2d4f-4a6c-8e0b-1d3f5a7c9e2b",
                    "name": "VIP",
                    "color": "#7c3aed",
                    "tagged_item_id": "9d1f3b5a-7c9e-4d2b-8f4a-6c8e0a2c4e6b"
                  }
                ],
                "created_at": "2026-06-01T20:11:00+00:00",
                "updated_at": "2026-10-04T14:01:02+00:00"
              }
            ],
            "meta": {
              "page": 1,
              "per_page": 50,
              "total": 1,
              "total_pages": 1
            }
          }
        },
        {
          "status": 400,
          "description": "A bad page, per_page or filter value.",
          "example": {
            "error": "order_by must be created_at, updated_at, last_order_at or email."
          }
        },
        {
          "status": 403,
          "description": "The key lacks fans:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "fans:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"fans:read\""
          }
        }
      ]
    },
    {
      "id": "lookup-fans",
      "method": "GET",
      "path": "/v1/fans/lookup",
      "summary": "Look up fans",
      "description": "A narrow search for a person at the door or on the phone: each field given matches partially and case-insensitively, all must match, and at most 3 fans come back (by id, no paging).",
      "auth": "api_key",
      "scope": "fans:read",
      "parameters": [
        {
          "name": "first_name",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Part of the first name.",
          "example": "dan"
        },
        {
          "name": "last_name",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Part of the last name.",
          "example": "le"
        },
        {
          "name": "email",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Part of the email.",
          "example": "example.com"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "7b1e4c2a-3d5f-4a6b-8c9d-0e1f2a3b4c5d",
                "email": "dana@example.com",
                "first_name": "Dana",
                "last_name": "Lee"
              }
            ]
          }
        },
        {
          "status": 400,
          "description": "No field given.",
          "example": {
            "error": "give first_name, last_name or email."
          }
        },
        {
          "status": 403,
          "description": "The key lacks fans:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "fans:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"fans:read\""
          }
        }
      ]
    },
    {
