    {
      "id": "discard-fan",
      "method": "DELETE",
      "path": "/v1/fans/{id}",
      "summary": "Remove a fan",
      "description": "Removes the contact: hidden from lists and exports, names cleared, tags taken off. Orders stay (they are the organization's records) and so does the fan's own consent. A later order or signup by the same email brings the profile back.",
      "auth": "api_key",
      "scope": "fans:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "Fan id.",
          "example": "7b1e4c2a-3d5f-4a6b-8c9d-0e1f2a3b4c5d"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "7b1e4c2a-3d5f-4a6b-8c9d-0e1f2a3b4c5d",
              "discarded": true
            }
          }
        },
        {
          "status": 404,
          "description": "No such fan in the key's organization (or it was removed).",
          "example": {
            "error": "fan not found"
          }
        },
        {
          "status": 403,
          "description": "The key lacks fans:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "fans:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"fans:write\""
          }
        }
      ]
    },
