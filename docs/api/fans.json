    {
      "id": "create-fan",
      "method": "POST",
      "path": "/v1/fans",
      "summary": "Add a fan",
      "description": "Adds a contact by hand. Only email (required), first_name and last_name are taken; the body may be wrapped as {\"fan\": {...}} or form-encoded as fan[email]=... A fan added this way is on no list: consent fields (subscribe_to_marketing and the like) are refused with 400. Adding the email of a removed fan brings that profile back. At most 1000 a day.",
      "auth": "api_key",
      "scope": "fans:write",
      "parameters": [
        {
          "name": "email",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "Email address.",
          "example": "sam@example.com"
        },
        {
          "name": "first_name",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "First name, at most 60 characters.",
          "example": "Sam"
        },
        {
          "name": "last_name",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Last name, at most 60 characters.",
          "example": "Park"
        }
      ],
      "responses": [
        {
          "status": 201,
          "description": "Created.",
          "example": {
            "data": {
              "id": "8c2f5d3b-4e6a-4b7c-9d0e-1f2a3b4c5d6e",
              "email": "sam@example.com",
              "first_name": "Sam",
              "last_name": "Park",
              "has_account": false,
              "source": "api",
              "created_at": "2026-06-01T20:11:00+00:00",
              "updated_at": "2026-10-04T14:01:02+00:00",
              "stats": {
                "orders": 0,
                "tickets": 0,
                "first_order_at": null,
                "last_order_at": null,
                "money": []
              },
              "consent": {
                "email_list": {
                  "status": "none",
                  "since": null,
                  "source": null,
                  "unsubscribed_at": null
                },
                "follows_org": false,
                "ad_consent": null,
                "marketing_mail_opt_out": false,
                "sms": {
                  "status": "none"
                }
              },
              "orders": [],
              "tags": [],
              "signups": []
            }
          }
        },
        {
          "status": 400,
          "description": "A bad email or name, or a consent field.",
          "example": {
            "error": "exos_fans: consent can't be set for a fan; they opt in themselves (signup form, ticket page)"
          }
        },
        {
          "status": 409,
          "description": "A fan with this email exists.",
          "example": {
            "error": "exos_fans: a fan with this email already exists"
          }
        },
        {
          "status": 403,
          "description": "The key lacks fans:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "fans:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"fans:write\""
          }
        }
      ],
      "request_example": {
        "fan": {
          "email": "sam@example.com",
          "first_name": "Sam",
          "last_name": "Park"
        }
      }
    },
    {
