{
  "file": "membership-writes",
  "name": "Memberships: products, members and imported attendees",
  "order": 41,
  "description": "Writes for membership products (create, edit, and the lifecycle draft → published ⇄ unpublished → archived; archived is final), staff-issued memberships (comps and members who paid somewhere else) and their edits, and attendees imported from other platforms. Each write runs as the member who created the key, needs that member's owner or manager role, takes an Idempotency-Key, and is logged; it does exactly what the same action in the dashboard does. Editing a product never changes existing members: they keep the benefits and price they joined with. Opendate's field names are accepted alongside Exos's (see each endpoint).",
  "endpoints": [
    {
      "id": "create-membership-product",
      "method": "POST",
      "path": "/v1/membership-products",
      "summary": "Create a membership product",
      "description": "Creates a draft: not on sale until published. Body fields are the product's (wrapped in membership_product or not); unknown fields are refused with 400. Opendate's venue, team and benefit-row fields are ignored: an Exos product belongs to the key's organization and its benefits are the fields below. Idempotency-Key makes a retry safe.",
      "auth": "api_key",
      "scope": "commerce:write",
      "parameters": [
        {
          "name": "name",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "1-120 characters, unique among the organization's products that aren't archived.",
          "example": "Member"
        },
        {
          "name": "billing",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "month or year (a Stripe subscription), or once (a one-time term). Set once.",
          "example": "month",
          "enum": [
            "month",
            "year",
            "once"
          ]
        },
        {
          "name": "currency",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "ISO 4217, lower case (default usd). Set once.",
          "example": "usd"
        },
        {
          "name": "default_monthly_amount_cents",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Opendate spelling: sets price_cents with billing month. Send this, default_annual_amount_cents, or price_cents + billing.",
          "example": 1500
        },
        {
          "name": "default_annual_amount_cents",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Opendate spelling: sets price_cents with billing year.",
          "example": 15000
        },
        {
          "name": "description",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "Shown to fans, up to 2000 characters.",
          "example": "Member price and presales all year."
        },
        {
          "name": "image_url",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "An https image URL.",
          "example": "https://cdn.example.com/member.png"
        },
        {
          "name": "price_cents",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Price per period (month, year) or for the one-time term, in the currency's minor unit (50 or more). Changing it applies to new members only.",
          "example": 1500
        },
        {
          "name": "duration_days",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Length of a one-time term in days (1-3660; default 365).",
          "example": 365
        },
        {
          "name": "discount_percent",
          "location": "body",
          "type": "number",
          "required": false,
          "description": "Member discount on tickets, 0-100.",
          "example": 10
        },
        {
          "name": "presale",
          "location": "body",
          "type": "boolean",
          "required": false,
          "description": "Members get the member presales.",
          "example": true
        },
        {
          "name": "free_tickets_per_period",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Free tickets each period, 0-100.",
          "example": 1
        },
        {
          "name": "guest_allowance",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Extra tickets a member may bring on a free ticket, 0-20.",
          "example": 1
        },
        {
          "name": "household_seats",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "People the member may share benefits with, 0-20.",
          "example": 1
        },
        {
          "name": "giftable",
          "location": "body",
          "type": "boolean",
          "required": false,
          "description": "Can be bought as a gift.",
          "example": true
        }
      ],
      "request_example": {
        "membership_product": {
          "name": "Member",
          "price_cents": 1500,
          "billing": "month",
          "discount_percent": 10,
          "presale": true,
          "free_tickets_per_period": 1
        }
      },
      "responses": [
        {
          "status": 201,
          "description": "Created (status draft).",
          "example": {
            "data": {
              "id": "7c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
              "name": "Member",
              "description": "Member price and presales all year.",
              "image_url": null,
              "price_cents": 1500,
              "currency": "usd",
              "billing": "month",
              "duration_days": 365,
              "discount_percent": 10,
              "presale": true,
              "free_tickets_per_period": 1,
              "guest_allowance": 1,
              "household_seats": 1,
              "giftable": true,
              "status": "draft",
              "active": false,
              "archived_at": null,
              "created_at": "2026-11-02T10:00:00+00:00",
              "updated_at": "2026-11-02T10:00:00+00:00",
              "members_count": 0
            }
          }
        },
        {
          "status": 400,
          "description": "A missing or bad field, or an unknown one.",
          "example": {
            "error": "unknown or read-only field: colour"
          }
        },
        {
          "status": 403,
          "description": "The key lacks commerce:write, or the member who created it may not do this.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "commerce:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"commerce:write\""
          }
        },
        {
          "status": 409,
          "description": "Another live product has that name.",
          "example": {
            "error": "there is already a membership product called Member"
          }
        }
      ]
    },
    {
