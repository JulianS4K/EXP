    {
      "id": "update-migrated-attendee",
      "method": "PATCH",
      "path": "/v1/migrated-attendees/{id}",
      "summary": "Update an imported attendee",
      "description": "Edits an imported attendee. Name, email, phone, plus-ones and note follow the guest list's rules (its plus-one limit, cap and capacity). The code (the other platform's barcode) is normalized like at import (spaces removed, upper case), unique within the event, and can't change once the party checked in. Source can change but not be blanked. An attendee synced from Eventbrite is edited there (409). Opendate spellings: first_name + last_name (guest_name), barcode (code).",
      "auth": "api_key",
      "scope": "tickets:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "Imported attendee id.",
          "example": "9e8d7c6b-5a49-4382-9716-a5b4c3d2e1f0"
        },
        {
          "name": "guest_name",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Name, 1-80 characters.",
          "example": "Ann Lee"
        },
        {
          "name": "email",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "Email.",
          "example": "ann@example.com"
        },
        {
          "name": "phone",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "Phone.",
          "example": "+1 555 0100"
        },
        {
          "name": "plus_ones",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Plus-ones (the list's limit applies).",
          "example": 1
        },
        {
          "name": "note",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "Note for the door, up to 200 characters.",
          "example": "VIP table 4"
        },
        {
          "name": "code",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "The other platform's barcode or ticket number.",
          "example": "POSH-0001"
        },
        {
          "name": "ticket_label",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "Their ticket type, up to 80 characters.",
          "example": "GA"
        },
        {
          "name": "source",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "The platform's name, 1-40 characters.",
          "example": "Posh"
        }
      ],
      "request_example": {
        "migrated_attendee": {
          "first_name": "Ann",
          "last_name": "Lee",
          "barcode": "posh 0001"
        }
      },
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "9e8d7c6b-5a49-4382-9716-a5b4c3d2e1f0",
              "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
              "event_name": "Late Show",
              "starts_at": "2026-11-14T01:00:00+00:00",
              "list_id": "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
              "guest_name": "Ann Lee",
              "email": "ann@example.com",
              "phone": null,
              "plus_ones": 0,
              "arrived": 0,
              "arrived_at": null,
              "note": null,
              "code": "POSH-0001",
              "ticket_label": "GA",
              "source": "Posh",
              "synced": false,
              "voided": false,
              "created_at": "2026-11-01T18:00:00+00:00",
              "updated_at": "2026-11-02T09:00:00+00:00"
            }
          }
        },
        {
          "status": 400,
          "description": "A bad or unknown field.",
          "example": {
            "error": "unknown or read-only field: arrived"
          }
        },
        {
          "status": 403,
          "description": "The key lacks tickets:write, or the member who created it may not do this.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "tickets:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"tickets:write\""
          }
        },
        {
          "status": 404,
          "description": "Not this organization's, or not an import.",
          "example": {
            "error": "imported attendee not found"
          }
        },
        {
          "status": 409,
          "description": "Code taken, party already checked in, list rule, or synced from Eventbrite.",
          "example": {
            "error": "another attendee of this event has that code"
          }
        }
      ]
    },
