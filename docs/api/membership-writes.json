    {
      "id": "issue-membership",
      "method": "POST",
      "path": "/v1/memberships",
      "summary": "Issue a membership",
      "description": "Staff-issues a membership: a comp, or one the member paid for somewhere else (source import, e.g. a roster move from another platform). Active at once with the product's benefits, for a one-time term that ends at expires_at (default: one period of the product). No card, no Stripe subscription, nothing charged. The member is matched to an Exos account by confirmed email; with none yet, the membership is held for that email and becomes theirs when they sign up. Refused while that email already holds a live membership of the product, or when the product is archived. Opendate spellings: membership wrapper, first_name + last_name (member_name), rebilling_date (expires_at), idempotency_key (used as the Idempotency-Key). 30 a minute per member.",
      "auth": "api_key",
      "scope": "commerce:write",
      "parameters": [
        {
          "name": "product_id",
          "location": "body",
          "type": "string (UUID)",
          "required": true,
          "description": "The membership product (not archived).",
          "example": "7c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f"
        },
        {
          "name": "email",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "The member's email.",
          "example": "dana@example.com"
        },
        {
          "name": "member_name",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "The member's name as staff know it, up to 120 characters.",
          "example": "Dana Lee"
        },
        {
          "name": "source",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "comp (default) or import (paid somewhere else).",
          "example": "import",
          "enum": [
            "comp",
            "import"
          ]
        },
        {
          "name": "expires_at",
          "location": "body",
          "type": "string (ISO 8601)",
          "required": false,
          "description": "When the membership ends: in the next 10 years.",
          "example": "2027-11-02T10:00:00Z"
        },
        {
          "name": "staff_notes",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Notes for staff (never shown to the member), up to 2000 characters.",
          "example": "Moved over from the old box office."
        }
      ],
      "request_example": {
        "membership": {
          "product_id": "7c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
          "email": "dana@example.com",
          "first_name": "Dana",
          "last_name": "Lee",
          "rebilling_date": "2027-11-02",
          "notes": "Moved over from the old box office."
        }
      },
      "responses": [
