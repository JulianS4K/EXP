    {
      "id": "update-membership",
      "method": "PATCH",
      "path": "/v1/memberships/{id}",
      "summary": "Update a membership",
      "description": "Renames the member, changes staff notes, moves the end date (expires_at) or sets the status to active, cancelled or expired. Cancelling or expiring ends the benefits now; reactivating needs an end date in the future. The status and dates of a membership Stripe bills mirror Stripe (cancel it through Stripe), a pending gift is changed with the gift routes, and a refunded membership is never revived: those answer 409. Opendate spellings: first_name + last_name, notes, current_period_end.",
      "auth": "api_key",
      "scope": "commerce:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "Membership id.",
          "example": "2b4d6f8a-1c3e-4a5b-9d7f-0e2a4c6e8b1d"
        },
        {
          "name": "member_name",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "The member's name.",
          "example": "Dana Lee-Park"
        },
        {
          "name": "staff_notes",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "Notes for staff.",
          "example": "Comped for the season."
        },
        {
          "name": "status",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "active, cancelled or expired.",
          "example": "cancelled",
          "enum": [
            "active",
            "cancelled",
            "expired"
          ]
        },
        {
          "name": "expires_at",
          "location": "body",
          "type": "string (ISO 8601)",
          "required": false,
          "description": "The new end of the current period (in the next 10 years).",
          "example": "2028-01-01T00:00:00Z"
        }
      ],
      "request_example": {
        "membership": {
          "first_name": "Dana",
          "last_name": "Lee-Park"
        }
      },
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "2b4d6f8a-1c3e-4a5b-9d7f-0e2a4c6e8b1d",
              "product_id": "7c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
              "product_name": "Member",
              "billing": "once",
              "holder_email": "dana@example.com",
              "member_name": "Dana Lee-Park",
              "has_account": true,
              "status": "active",
              "effective_status": "active",
              "current_period_start": "2026-11-02T10:00:00+00:00",
              "current_period_end": "2027-11-02T10:00:00+00:00",
              "cancel_at_period_end": false,
              "source": "import",
              "benefits": {
                "discount_percent": 10,
                "presale": true,
                "free_tickets_per_period": 1,
                "guest_allowance": 1,
                "household_seats": 1,
                "term": "1 month"
              },
              "ended_reason": null,
              "stripe_billed": false,
              "staff_notes": "Moved over from the old box office.",
              "issued_by": "5f1e2d3c-4b5a-4968-8776-655443322110",
              "created_at": "2026-11-02T10:00:00+00:00",
              "updated_at": "2026-11-02T10:00:00+00:00"
            }
          }
        },
        {
          "status": 400,
          "description": "A bad or read-only field.",
          "example": {
            "error": "unknown or read-only field: holder_email"
          }
        },
        {
          "status": 403,
          "description": "The key lacks commerce:write, or the member who created it may not do this.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "commerce:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"commerce:write\""
          }
        },
        {
          "status": 404,
          "description": "Not this organization's membership.",
          "example": {
            "error": "membership not found"
          }
        },
        {
          "status": 409,
          "description": "Billed by Stripe, an unclaimed gift, or ended for good.",
          "example": {
            "error": "Stripe bills this membership: change or cancel it through Stripe"
          }
        }
      ]
    },
