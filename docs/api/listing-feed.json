{
  "file": "listing-feed",
  "name": "Listing feed",
  "order": 14,
  "description": "A public, read-only feed of one organization's events and lineups for listing sites (Bandsintown, JamBase, Songkick) and a venue's own website, shaped like Opendate's public listing. Partners authenticate with a shared key, one per partner, which an org owner mints in Org settings → Listing feed or with POST /v1/listing-keys (`org:admin`). The feed answers any origin and is cacheable with an ETag. Guide: docs/listing-feed.md.",
  "endpoints": [
    {
      "id": "public-list-events",
      "method": "GET",
      "path": "/v1/public/events",
      "summary": "List public events",
      "description": "The key's organization's public events: published, listed (not link-only), starting at or after q[start_time_gteq] (default now), with their lineup. Opendate's public listing shape and paging, so a partner already reading Opendate needs a new base URL and key only. Times are ISO 8601 with the offset of the event's time zone. ticket_url is the event page tagged utm_source=<partner type> (listing for other), utm_medium=listing, utm_campaign=listing_feed. price_min / price_max are all-in (passed-on fees and tax included) over the public ticket types, in major units. on_sale is false when sold out or no public ticket type is inside its sale window. A secret-location event shows only its public area label as venue_name; venue_id, venue_permalink, city, region and country are null and the address never appears. An online-only event has online: true and no venue. performers is the lineup in running order: performer_id (also under the deprecated alias id) is the slot, artist_id and everything under artist belong to the artist; spotify_id, spotify_uri and spotify_url are all set or all null; canonical_artist_id is set when the artist was merged into another. name, permalink, image_url and image_thumb_url_for_json are deprecated flat copies of the artist block for older readers. An event with only free-text performer names lists them with artist_id null. Cached 60 seconds; poll at most once a minute.",
      "auth": "shared_key",
      "scope": null,
      "parameters": [
        {
          "name": "shared_key",
          "location": "query",
          "type": "string",
          "required": true,
          "description": "The partner's shared key (sh_live_…). The X-Shared-Key header works too; from a browser use the query parameter (a custom header needs a CORS preflight).",
          "example": "sh_live_9f2c4e6a8b0d1f3e5a7c9e1b3d5f7a9c2e4b6d8f0a1c3e5"
        },
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number (1-based). Anything but a positive integer is a 400; a page past the end has an empty collection.",
          "example": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 30,
          "description": "Entries per page (default 30); values above 250 are treated as 250.",
          "example": 30
        },
        {
          "name": "genre",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only events with one of these genres or subgenres (case-insensitive). Comma-separated or repeated; genre[] works too.",
          "example": "house,techno"
        },
        {
          "name": "exclude_genre",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Leave out events with any of these genres.",
          "example": "comedy"
        },
        {
          "name": "venue_id",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only events at this venue (venue_id in the entries).",
          "example": "the-loft"
        },
        {
          "name": "artist_id",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Only events with this artist on the bill (an artist merged into it counts).",
          "example": "7a1c9e2b-4d6f-4a8b-9c0d-2e3f4a5b6c7d"
        },
        {
          "name": "q[start_time_gteq]",
          "location": "query",
          "type": "string (ISO 8601)",
          "required": false,
          "description": "Events starting at or after this date or time; default now. start_time_gteq works too. Pass an early date for past events.",
          "example": "2026-12-01"
        },
        {
          "name": "q[start_time_lteq]",
          "location": "query",
          "type": "string (ISO 8601)",
          "required": false,
          "description": "Events starting at or before this date or time. start_time_lteq works too.",
          "example": "2027-03-01"
        },
        {
          "name": "q[s]",
          "location": "query",
          "type": "string",
          "required": false,
          "default": "start_time asc",
          "description": "Sort: start_time asc (default), start_time desc, published_at asc or published_at desc.",
          "enum": [
            "start_time asc",
            "start_time desc",
            "published_at asc",
            "published_at desc"
          ],
          "example": "published_at desc"
        },
        {
          "name": "tag_id",
          "location": "query",
          "type": "integer",
          "required": false,
          "description": "Not supported: Exos events have no tags, so a tag_id is a 400 rather than an unfiltered answer.",
          "example": 3
        },
        {
          "name": "If-None-Match",
          "location": "header",
          "type": "string",
          "required": false,
          "description": "The ETag of the last response; an unchanged answer is 304 with no body.",
          "example": "\"q3L0f2kD8xV1bN7cT5rW9yZ4aE6\""
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "current_page": 1,
            "per_page": 30,
            "total_entries": 2,
            "total_pages": 1,
