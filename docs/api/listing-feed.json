    {
      "id": "create-listing-key",
      "method": "POST",
      "path": "/v1/listing-keys",
      "summary": "Create a shared key",
      "description": "Mints a shared key for one partner and returns it, with a ready feed URL, this once; only its SHA-256 hash is kept. At most 20 active keys per organization.",
      "auth": "api_key",
      "scope": "org:admin",
      "parameters": [
        {
          "name": "partner_type",
          "location": "body",
          "type": "string",
          "required": false,
          "default": "other",
          "description": "Who reads it; tags ticket links with utm_source.",
          "enum": [
            "bandsintown",
            "jambase",
            "songkick",
            "website",
            "other"
          ],
          "example": "bandsintown"
        },
        {
          "name": "label",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Up to 80 characters; defaults to the partner type.",
          "example": "Bandsintown"
        }
      ],
      "request_example": {
        "partner_type": "bandsintown",
        "label": "Bandsintown"
      },
      "responses": [
        {
          "status": 201,
          "description": "Created. key is shown only here.",
          "example": {
            "data": {
              "id": "e3f4a5b6-c7d8-4e9f-a0b1-2c3d4e5f6071",
              "label": "Bandsintown",
              "partner_type": "bandsintown",
              "key_prefix": "sh_live_9f2c4e6a",
              "created_at": "2026-10-23T10:00:00+00:00",
              "key": "sh_live_9f2c4e6a8b0d1f3e5a7c9e1b3d5f7a9c2e4b6d8f0a1c3e5",
              "feed_url": "https://<project-ref>.supabase.co/functions/v1/exos-api/v1/public/events?shared_key=sh_live_9f2c4e6a8b0d1f3e5a7c9e1b3d5f7a9c2e4b6d8f0a1c3e5"
            }
          }
        },
        {
          "status": 400,
          "description": "An unknown partner type or a long label.",
          "example": {
            "error": "listing key: partner_type must be bandsintown, jambase, songkick, website or other"
          }
        },
        {
          "status": 403,
          "description": "The key lacks org:admin.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "org:admin"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
          }
        },
        {
          "status": 409,
          "description": "20 active keys already.",
          "example": {
            "error": "listing key: at most 20 active shared keys per organization; revoke one first"
          }
        }
      ]
    },
    {
      "id": "revoke-listing-key",
      "method": "DELETE",
      "path": "/v1/listing-keys/:id",
      "summary": "Revoke a shared key",
      "description": "The key stops working at once. Revoking a revoked key is fine.",
      "auth": "api_key",
      "scope": "org:admin",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The shared key's id.",
          "example": "e3f4a5b6-c7d8-4e9f-a0b1-2c3d4e5f6071"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "e3f4a5b6-c7d8-4e9f-a0b1-2c3d4e5f6071",
              "revoked": true
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks org:admin.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "org:admin"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
          }
        },
        {
          "status": 404,
          "description": "No such key in the key's organization.",
          "example": {
            "error": "shared key not found"
          }
        }
      ]
    }
