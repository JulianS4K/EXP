{
  "file": "finance",
  "name": "Finance categories, ledger codes and items",
  "order": 65,
  "description": "Your finance categories (each with a general ledger code from your chart of accounts) and each show's income and expense lines, which the settlement and the P&L read. Money is in cents. Reads need `finance:read`, writes `finance:write`.",
  "endpoints": [
    {
      "id": "list-finance-categories",
      "method": "GET",
      "path": "/v1/finance-categories",
      "summary": "List finance categories",
      "description": "By position. The defaults are created on first use: Talent, Production, Marketing, Hospitality, Venue rental, Staff, Bar/F&B income, Merch income, Other. Talent, Venue rental, Merch income and Other are built in (system: true): the maths reads them.",
      "auth": "api_key",
      "scope": "finance:read",
      "parameters": [],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "7d10a3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                "key": "production",
                "name": "Production",
                "kind": "expense",
                "system": false,
                "gl_code_id": "8e20b4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                "position": 20,
                "created_at": "2026-10-31T15:04:05.120+00:00",
                "updated_at": "2026-10-31T15:04:05.120+00:00"
              }
            ]
          }
        },
        {
          "status": 403,
          "description": "The key lacks finance:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "finance:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"finance:read\""
          }
        }
      ]
    },
    {
      "id": "create-finance-category",
      "method": "POST",
      "path": "/v1/finance-categories",
      "summary": "Create a finance category",
      "description": "At most 50 per organization.",
      "auth": "api_key",
      "scope": "finance:write",
      "parameters": [
        {
          "name": "name",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "1-60 characters.",
          "example": "Security"
        },
        {
          "name": "kind",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Default expense.",
          "enum": [
            "income",
            "expense",
            "both"
          ],
          "example": "expense"
        },
        {
          "name": "gl_code_id",
          "location": "body",
          "type": "string (UUID) or null",
          "required": false,
          "description": "One of your ledger codes.",
          "example": "8e20b4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "position",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "0-1000.",
          "example": 100
        }
      ],
      "responses": [
        {
          "status": 201,
          "description": "Created.",
          "example": {
            "data": {
              "id": "7d10a3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "key": "production",
              "name": "Production",
              "kind": "expense",
              "system": false,
              "gl_code_id": "8e20b4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "position": 20,
              "created_at": "2026-10-31T15:04:05.120+00:00",
              "updated_at": "2026-10-31T15:04:05.120+00:00"
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks finance:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "finance:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"finance:write\""
          }
        },
        {
          "status": 400,
          "description": "A field is missing or invalid; the message names it.",
          "example": {
            "error": "terms.percentage must be a percentage from 0 to 100 (at most 3 decimals)"
          }
        }
      ]
    },
