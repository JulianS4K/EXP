    {
      "id": "create-finance-item",
      "method": "POST",
      "path": "/v1/events/:id/finance-items",
      "summary": "Add a finance item",
      "description": "At most 200 per show.",
      "auth": "api_key",
      "scope": "finance:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event id.",
          "example": "7d10a3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "label",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "1-120 characters (Opendate: name).",
          "example": "Sound"
        },
        {
          "name": "kind",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Default expense.",
          "enum": [
            "income",
            "expense"
          ],
          "example": "expense"
        },
        {
          "name": "category_id",
          "location": "body",
          "type": "string (UUID) or null",
          "required": false,
          "description": "A finance category of a kind that fits.",
          "example": "8e20b4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        },
        {
          "name": "amount_cents",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "What it is.",
          "example": 200000
        },
        {
          "name": "forecast_cents",
          "location": "body",
          "type": "integer or null",
          "required": false,
          "description": "In the P&L forecast column (replaces the budget lines of its category).",
          "example": 180000
        },
        {
          "name": "estimate_cents",
          "location": "body",
