{
  "file": "venues",
  "name": "Venues and rooms",
  "order": 60,
  "description": "The organization's venues (its own, or rooms it rents or books from a partner) and their rooms. Holds and converted events point at them. Reads need `booking:read`, writes `booking:write`. The /v1/venue_ownerships paths answer the same routes as /v1/venues.",
  "endpoints": [
    {
      "id": "list-venues",
      "method": "GET",
      "path": "/v1/venues",
      "summary": "List venues",
      "description": "The organization's venues, by name. Also at /v1/venue_ownerships.",
      "auth": "api_key",
      "scope": "booking:read",
      "parameters": [
        {
          "name": "q",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only venues whose name contains this (also `q[name_cont]`).",
          "example": "hall"
        },
        {
          "name": "relationship",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only venues of this relationship.",
          "enum": [
            "owned",
            "rented",
            "partner"
          ],
          "example": "rented"
        },
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
          "example": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 50,
          "description": "Rows per page, 1-200 (default 50).",
          "example": 50
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "7a10c3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                "name": "Lincoln Hall",
                "address": {
                  "street": "2424 N Lincoln Ave",
                  "city": "Chicago",
                  "region": "IL",
                  "country": "US",
                  "postal": "60614"
                },
                "timezone": "America/Chicago",
                "capacity": 520,
                "website": "https://lincolnhall.example/",
                "permalink": "lincoln-hall",
                "relationship": "owned",
                "contact": null,
                "notes": null,
                "created_at": "2026-10-29T15:04:05.120+00:00",
                "updated_at": "2026-10-29T15:04:05.120+00:00"
              },
              {
                "id": "7a10c3e2-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
                "name": "Metro",
                "address": {
                  "city": "Chicago",
                  "region": "IL",
                  "country": "US"
                },
                "timezone": "America/Chicago",
                "capacity": 1100,
                "website": null,
                "permalink": "metro",
                "relationship": "rented",
                "contact": {
                  "name": "Club GM",
                  "email": "gm@metro.example",
                  "phone": "555-0100"
                },
                "notes": null,
                "created_at": "2026-10-29T15:04:05.120+00:00",
                "updated_at": "2026-10-29T15:04:05.120+00:00"
              }
            ],
            "meta": {
              "page": 1,
              "per_page": 50,
              "total": 2,
              "total_pages": 1
            }
          }
