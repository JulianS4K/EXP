    {
      "id": "create-venue",
      "method": "POST",
      "path": "/v1/venues",
      "summary": "Create a venue",
      "description": "Adds a venue (at most 200 per organization). Also at POST /v1/venue_ownerships.",
      "auth": "api_key",
      "scope": "booking:write",
      "parameters": [
        {
          "name": "name",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "Up to 100 characters.",
          "example": "Lincoln Hall"
        },
        {
          "name": "address",
          "location": "body",
          "type": "object or null",
          "required": false,
          "description": "{ street, city, region, country, postal }, each up to 120 characters.",
          "example": {
            "street": "2424 N Lincoln Ave",
            "city": "Chicago",
            "region": "IL",
            "country": "US",
            "postal": "60614"
          }
        },
        {
          "name": "timezone",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "IANA time zone, e.g. America/Chicago. Holds are nights in this zone and a converted night starts in it. `time_zone` is accepted too.",
          "example": "America/Chicago"
        },
        {
          "name": "capacity",
          "location": "body",
          "type": "integer or null",
          "required": false,
          "description": "0-1,000,000.",
          "example": 520
        },
        {
          "name": "website",
          "location": "body",
          "type": "string (URL) or null",
          "required": false,
          "description": "An https URL.",
          "example": "https://lincolnhall.example/"
        },
        {
          "name": "permalink",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "Lowercase letters, digits and dashes, unique in the organization. Left out on create, it is made from the name (with -2, -3 ... when taken).",
          "example": "lincoln-hall"
        },
        {
          "name": "relationship",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "owned (default), rented (you rent it for your shows) or partner. Holds on any venue count only your organization's holds.",
          "enum": [
            "owned",
            "rented",
            "partner"
          ],
          "example": "owned"
        },
        {
          "name": "contact",
          "location": "body",
          "type": "object or null",
          "required": false,
          "description": "Who you book the venue from: { name, email, phone }.",
          "example": {
            "name": "Club GM",
            "email": "gm@metro.example",
            "phone": "555-0100"
          }
        },
        {
          "name": "notes",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "Up to 2000 characters."
        }
      ],
      "responses": [
        {
          "status": 201,
          "description": "Created.",
          "example": {
            "data": {
              "id": "7a10c3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "name": "Lincoln Hall",
              "address": {
                "street": "2424 N Lincoln Ave",
                "city": "Chicago",
                "region": "IL",
                "country": "US",
                "postal": "60614"
              },
              "timezone": "America/Chicago",
              "capacity": 520,
              "website": "https://lincolnhall.example/",
              "permalink": "lincoln-hall",
              "relationship": "owned",
              "contact": null,
              "notes": null,
              "created_at": "2026-10-29T15:04:05.120+00:00",
              "updated_at": "2026-10-29T15:04:05.120+00:00"
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks booking:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "booking:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"booking:write\""
          }
        },
        {
          "status": 400,
          "description": "A field is missing or invalid; the message names it.",
          "example": {
            "error": "timezone must be an IANA zone, e.g. America/New_York"
          }
        },
        {
          "status": 409,
          "description": "The permalink is in use, or the organization has 200 venues.",
          "example": {
            "error": "That conflicts with an existing record (e.g. a permalink in use or a second doors row)."
          }
        }
      ],
      "request_example": {
        "name": "Lincoln Hall",
        "timezone": "America/Chicago",
        "capacity": 520,
        "address": {
          "street": "2424 N Lincoln Ave",
          "city": "Chicago",
          "region": "IL",
          "country": "US",
          "postal": "60614"
        }
      }
    },
