      "path": "/v1/venues/:id",
      "summary": "Delete a venue",
      "description": "Deletes a venue and its rooms. A venue any hold night points at (even a cleared one) is kept: 409. Events linked to it keep their own venue name and address and lose the link. Also at DELETE /v1/venue_ownerships/:id.",
      "auth": "api_key",
      "scope": "booking:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The venue's id. One of another organization answers 404.",
          "example": "7a10c3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "7a10c3e1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
              "deleted": true
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks booking:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "booking:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"booking:write\""
          }
        },
        {
          "status": 404,
          "description": "No such venue in the key's organization (or the id is malformed).",
          "example": {
            "error": "venue not found"
          }
        },
        {
          "status": 409,
          "description": "Hold nights point at the venue.",
          "example": {
            "error": "Still in use: holds or events point at it."
          }
        }
      ]
