    {
      "id": "set-lineup",
      "method": "PUT",
      "path": "/v1/events/:id/lineup",
      "summary": "Replace an event's lineup",
      "description": "The whole lineup in running order; positions come from the order (1..n). At most 20 slots. Every artist must be the organization's; a merged artist is replaced by the one it was merged into; the same artist twice is a 400. act_type defaults to headline for the first slot and support after. A slot whose artist, act type, position and set time are unchanged keeps its id and updated_at. An empty list clears the lineup. The event's performer names follow (first 10).",
      "auth": "api_key",
      "scope": "events:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event's id.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "lineup",
          "location": "body",
          "type": "array of objects",
          "required": true,
          "description": "[{ artist_id, act_type?, set_time? (ISO 8601) }]. A bare JSON array works too.",
          "example": [
            {
              "artist_id": "7a1c9e2b-4d6f-4a8b-9c0d-2e3f4a5b6c7d",
              "act_type": "headline",
              "set_time": "2026-12-05T04:30:00Z"
            },
            {
              "artist_id": "8b2d0f3c-5e7a-4b9c-8d1e-3f4a5b6c7d8e",
              "act_type": "opener"
            }
          ]
        }
      ],
      "request_example": {
        "lineup": [
          {
            "artist_id": "7a1c9e2b-4d6f-4a8b-9c0d-2e3f4a5b6c7d",
            "act_type": "headline",
            "set_time": "2026-12-05T04:30:00Z"
          },
          {
            "artist_id": "8b2d0f3c-5e7a-4b9c-8d1e-3f4a5b6c7d8e",
            "act_type": "opener"
          }
        ]
      },
