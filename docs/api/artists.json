{
  "file": "artists",
  "name": "Artists and lineups",
  "order": 12,
  "description": "The organization's artists (one canonical Spotify id each, a unique permalink, photo, genres and links) and each event's lineup: ordered slots with an act type (headline, support, opener, dj, host, other) and an optional set time. Saving a lineup also rewrites the event's performer names (the first 10), so emails and the other feeds follow it. Duplicate artists are merged: the merged artist stays as an alias with canonical_artist_id set, and its slots move to the artist it was merged into. Reads need `events:read`, writes `events:write`. Guide: docs/listing-feed.md.",
  "endpoints": [
    {
      "id": "list-artists",
      "method": "GET",
      "path": "/v1/artists",
      "summary": "List artists",
      "description": "The organization's artists, by name. Merged artists (aliases) are left out unless include_merged=true.",
      "auth": "api_key",
      "scope": "events:read",
      "parameters": [
        {
          "name": "q",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Name contains this text (case-insensitive). q[name_cont] works too.",
          "example": "lum"
        },
        {
          "name": "spotify_id",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only the artists with this Spotify id (a link or URI is normalized first).",
          "example": "4Z8W4fKeB5YxbusRsdQVPb"
        },
        {
          "name": "include_merged",
          "location": "query",
          "type": "boolean",
          "required": false,
          "default": "false",
          "description": "true also returns artists merged into another.",
          "example": "true"
        },
        {
          "name": "q[s]",
          "location": "query",
          "type": "string",
          "required": false,
          "default": "name asc",
          "description": "Sort: name, created_at or updated_at, then asc or desc. sort works too.",
          "example": "updated_at desc"
        },
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 1,
          "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
          "example": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "default": 50,
          "description": "Rows per page, 1-200 (default 50).",
          "example": 50
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "7a1c9e2b-4d6f-4a8b-9c0d-2e3f4a5b6c7d",
                "name": "Lumen",
                "permalink": "lumen",
                "bio": "Brooklyn house duo.",
                "genres": [
                  "House",
                  "Disco"
                ],
                "links": {
                  "instagram": "https://instagram.com/lumen.music"
                },
                "image_url": "https://<project-ref>.supabase.co/storage/v1/object/public/exos-media/event-images/0f1e2d3c/artist-lumen.jpg",
                "image_thumb_url": "https://<project-ref>.supabase.co/storage/v1/object/public/exos-media/event-images/0f1e2d3c/artist-lumen.jpg",
                "spotify_id": "4Z8W4fKeB5YxbusRsdQVPb",
                "spotify_uri": "spotify:artist:4Z8W4fKeB5YxbusRsdQVPb",
                "spotify_url": "https://open.spotify.com/artist/4Z8W4fKeB5YxbusRsdQVPb",
                "canonical_artist_id": null,
                "created_at": "2026-10-20T09:15:40.112+00:00",
                "updated_at": "2026-10-22T18:02:11.904+00:00"
              }
            ],
            "meta": {
              "page": 1,
              "per_page": 50,
              "total": 1,
              "total_pages": 1
            }
          }
        },
        {
          "status": 400,
          "description": "A bad filter, sort, page or per_page.",
          "example": {
            "error": "sort must be name, created_at or updated_at, then asc or desc."
          }
        },
        {
          "status": 403,
          "description": "The key lacks events:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "events:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"events:read\""
          }
        }
      ]
    },
    {
      "id": "create-artist",
      "method": "POST",
      "path": "/v1/artists",
      "summary": "Create an artist",
      "description": "JSON body with the fields below, or Opendate-style: wrapped as { \"artist\": { … } }, or form-encoded as artist[name]=….",
      "auth": "api_key",
      "scope": "events:write",
      "parameters": [
        {
          "name": "name",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "Display name, 1-120 characters. Names need not be unique (merge duplicates).",
          "example": "Lumen"
        },
        {
          "name": "permalink",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Lowercase letters, digits and dashes, unique in the organization. Generated from the name when left out (lumen, then lumen-2, …); an explicit one that is taken is a 409.",
          "example": "lumen"
        },
        {
          "name": "spotify",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "The artist's Spotify link, spotify:artist: URI or 22-character id, normalized to one id; spotify_id, spotify_url and spotify_uri are accepted under those names too. Album, track or playlist links are a 400. \"\" or null clears it. Exos never calls Spotify.",
          "example": "https://open.spotify.com/artist/4Z8W4fKeB5YxbusRsdQVPb?si=1a2b"
        },
        {
          "name": "bio",
          "location": "body",
          "type": "string or null",
          "required": false,
          "description": "Up to 4000 characters.",
          "example": "Brooklyn house duo."
        },
        {
          "name": "genres",
          "location": "body",
          "type": "array of strings",
          "required": false,
          "description": "Up to 10, 40 characters each; duplicates (any case) are dropped.",
          "example": [
            "House",
            "Disco"
          ]
        },
        {
          "name": "links",
          "location": "body",
          "type": "object",
          "required": false,
          "description": "http(s) URLs keyed by website, instagram, facebook, twitter, tiktok, youtube, soundcloud, bandcamp or apple_music. An empty value drops the link; an unknown key is a 400.",
          "example": {
            "instagram": "https://instagram.com/lumen.music"
          }
        },
        {
          "name": "image_url",
          "location": "body",
          "type": "string (URL) or null",
          "required": false,
          "description": "An https URL of the photo. image_thumb_url likewise; without one the thumbnail is the photo.",
          "example": "https://<project-ref>.supabase.co/storage/v1/object/public/exos-media/event-images/0f1e2d3c/artist-lumen.jpg"
        }
      ],
      "request_example": {
        "name": "Lumen",
        "spotify": "https://open.spotify.com/artist/4Z8W4fKeB5YxbusRsdQVPb",
        "genres": [
          "House",
          "Disco"
        ]
      },
      "responses": [
        {
          "status": 201,
          "description": "Created.",
          "example": {
            "data": {
              "id": "7a1c9e2b-4d6f-4a8b-9c0d-2e3f4a5b6c7d",
              "org_id": "5d2e8c1a-3b4f-4e6a-9c7d-1f2e3a4b5c6d",
              "name": "Lumen",
              "permalink": "lumen",
              "bio": "Brooklyn house duo.",
              "genres": [
                "House",
                "Disco"
              ],
              "links": {
                "instagram": "https://instagram.com/lumen.music"
              },
              "image_url": "https://<project-ref>.supabase.co/storage/v1/object/public/exos-media/event-images/0f1e2d3c/artist-lumen.jpg",
              "image_thumb_url": "https://<project-ref>.supabase.co/storage/v1/object/public/exos-media/event-images/0f1e2d3c/artist-lumen.jpg",
              "spotify_id": "4Z8W4fKeB5YxbusRsdQVPb",
              "spotify_uri": "spotify:artist:4Z8W4fKeB5YxbusRsdQVPb",
              "spotify_url": "https://open.spotify.com/artist/4Z8W4fKeB5YxbusRsdQVPb",
              "canonical_artist_id": null,
              "created_at": "2026-10-20T09:15:40.112+00:00",
              "updated_at": "2026-10-22T18:02:11.904+00:00"
            }
          }
        },
        {
          "status": 400,
          "description": "A missing name or an invalid field; the message names it.",
          "example": {
            "error": "spotify: not a Spotify artist link, URI or id"
          }
        },
        {
          "status": 403,
          "description": "The key lacks events:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "events:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"events:write\""
          }
        },
        {
          "status": 409,
          "description": "The permalink is taken.",
          "example": {
            "error": "artist: permalink \"lumen\" is taken"
          }
        }
      ]
    },
