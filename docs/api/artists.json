    {
      "id": "merge-artist",
      "method": "POST",
      "path": "/v1/artists/:id/merge",
      "summary": "Merge an artist into another",
      "description": "For the same act entered twice. The artist in the path becomes an alias of target_artist_id (canonical_artist_id); its lineup slots move to the target, a slot on an event that already has the target is removed and the lineup renumbered, and artists merged into it follow. Later lineup saves that name it get the target. Merging a merged artist, or into one, is a 409.",
      "auth": "api_key",
      "scope": "events:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The artist to merge's id.",
          "example": "9c3e1a4d-6f8b-4cad-9e2f-4a5b6c7d8e9f"
        },
        {
          "name": "target_artist_id",
          "location": "body",
          "type": "string (UUID)",
          "required": true,
          "description": "The artist to keep.",
          "example": "7a1c9e2b-4d6f-4a8b-9c0d-2e3f4a5b6c7d"
        }
      ],
      "request_example": {
        "target_artist_id": "7a1c9e2b-4d6f-4a8b-9c0d-2e3f4a5b6c7d"
      },
      "responses": [
        {
          "status": 200,
          "description": "OK: the merged artist and how many events' lineups changed.",
          "example": {
            "data": {
              "artist": {
                "id": "9c3e1a4d-6f8b-4cad-9e2f-4a5b6c7d8e9f",
                "org_id": "5d2e8c1a-3b4f-4e6a-9c7d-1f2e3a4b5c6d",
                "name": "Lumen",
                "permalink": "lumen-2",
                "bio": "Brooklyn house duo.",
                "genres": [
                  "House",
                  "Disco"
                ],
                "links": {
                  "instagram": "https://instagram.com/lumen.music"
                },
                "image_url": "https://<project-ref>.supabase.co/storage/v1/object/public/exos-media/event-images/0f1e2d3c/artist-lumen.jpg",
                "image_thumb_url": "https://<project-ref>.supabase.co/storage/v1/object/public/exos-media/event-images/0f1e2d3c/artist-lumen.jpg",
                "spotify_id": "4Z8W4fKeB5YxbusRsdQVPb",
                "spotify_uri": "spotify:artist:4Z8W4fKeB5YxbusRsdQVPb",
                "spotify_url": "https://open.spotify.com/artist/4Z8W4fKeB5YxbusRsdQVPb",
                "canonical_artist_id": "7a1c9e2b-4d6f-4a8b-9c0d-2e3f4a5b6c7d",
                "created_at": "2026-10-20T09:15:40.112+00:00",
                "updated_at": "2026-10-22T18:02:11.904+00:00"
              },
              "events_updated": 2
            }
          }
        },
        {
          "status": 400,
          "description": "No target, or the artist itself.",
          "example": {
            "error": "artist: pick another artist to merge into"
          }
        },
        {
          "status": 403,
          "description": "The key lacks events:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "events:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"events:write\""
          }
        },
        {
          "status": 404,
          "description": "Either artist is not in the key's organization.",
          "example": {
            "error": "merge target not found"
          }
        },
        {
          "status": 409,
          "description": "Already merged, or the target was merged.",
          "example": {
            "error": "artist: already merged into another artist"
          }
        }
      ]
    },
