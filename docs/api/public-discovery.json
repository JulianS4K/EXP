  {
   "id": "public-create-fan",
   "method": "POST",
   "path": "/v1/public/fans",
   "summary": "Sign up to a list",
   "description": "A signup to an organizer's signup form (form_id in the body), exactly as the embed's: double opt-in (the address gets a confirm mail; only its link puts them on the list), texts confirmed signed in, the optional captcha. Always answers { ok, status: check_email }, so it never tells whether an address is on a list. 10 a minute per network, 120 per form. Opendate POST /public/fans; the fan[...] wrapper is accepted.",
   "auth": "public",
   "scope": null,
   "parameters": [
    {
     "name": "form_id",
     "location": "body",
     "type": "string (UUID)",
     "required": true,
     "description": "The signup form (signup_form_id is accepted too).",
     "example": "f0f0f0f0-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
    },
    {
     "name": "email",
     "location": "body",
     "type": "string",
     "required": true,
     "description": "The address.",
     "example": "sam@example.com"
    },
    {
     "name": "first_name",
     "location": "body",
     "type": "string",
     "required": false,
     "description": "At most 60 characters.",
     "example": "Sam"
    },
    {
     "name": "subscribe_to_marketing_sms",
     "location": "body",
     "type": "boolean",
     "required": false,
     "description": "Ask for texts too (confirmed signed in).",
     "example": false
    }
   ],
   "responses": [
    {
     "status": 200,
     "description": "OK.",
     "example": {
      "ok": true,
      "status": "check_email"
     }
    },
    {
     "status": 422,
     "description": "A missing or bad field.",
     "example": {
      "error": "email is required."
     }
    },
    {
     "status": 429,
     "description": "Too many signups from this network or to this form.",
     "example": {
      "error": "too many signups, try again in a minute"
     }
    }
   ],
   "request_example": {
    "form_id": "f0f0f0f0-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
    "email": "sam@example.com"
   }
  },
  {
   "id": "public-create-form-submission",
   "method": "POST",
   "path": "/v1/public/forms/:id/submissions",
   "summary": "Submit a signup form",
   "description": "The same as POST /v1/public/fans with the form in the path (Opendate's embed path POST /forms/{uuid}/submissions).",
   "auth": "public",
   "scope": null,
   "parameters": [
    {
     "name": "id",
     "location": "path",
     "type": "string (UUID)",
     "required": true,
     "description": "The signup form id.",
     "example": "f0f0f0f0-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
    },
    {
     "name": "email",
     "location": "body",
     "type": "string",
     "required": true,
     "description": "The address.",
     "example": "sam@example.com"
    }
   ],
   "responses": [
    {
     "status": 200,
     "description": "OK.",
     "example": {
      "ok": true,
      "status": "check_email"
     }
    },
    {
     "status": 404,
     "description": "A form that isn't taking signups.",
     "example": {
      "error": "this form isn't taking signups"
     }
    }
   ],
   "request_example": {
    "email": "sam@example.com"
   }
  }
 ]
}
