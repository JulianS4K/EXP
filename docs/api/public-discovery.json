   "auth": "public",
   "scope": null,
   "parameters": [
    {
     "name": "q",
     "location": "query",
     "type": "string",
     "required": false,
     "description": "2-80 letters or digits (query is accepted too).",
     "example": "jazz"
    }
   ],
   "responses": [
