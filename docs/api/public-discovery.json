{
 "file": "public-discovery",
 "name": "Public: discovery and signups (no credential)",
 "order": 14.5,
 "description": "What a fan app or a venue's own site shows anyone, with no key: published events (ticket types priced all-in, as everywhere a buyer sees a price), organizers with upcoming shows, search, an organizer's series, and signup forms. Rate limited per network. For a listing partner's feed with its own key, use the listing feed (/v1/public/events).",
 "endpoints": [
  {
   "id": "public-discovery-events",
   "method": "GET",
   "path": "/v1/public/discovery/events",
   "summary": "Discover events",
   "description": "Published events from now on, soonest first, optionally of some genres (GET /v1/public/discovery/genres lists them): the public event, its organizer and from_price_cents, the lowest all-in ticket price on sale (fees and exclusive tax included; buyers never see a fee line). Opendate GET /public/discovery/confirms. No credential; CORS-open; 60 requests a minute per network (429 with Retry-After over it). Events the organizer marked noindex are left out here and in search.",
   "auth": "public",
   "scope": null,
   "parameters": [
    {
     "name": "page",
     "location": "query",
     "type": "integer",
     "required": false,
     "description": "Page number, 1-10000 (default 1).",
     "example": 1
    },
    {
     "name": "per_page",
     "location": "query",
     "type": "integer",
     "required": false,
     "description": "Rows per page, 1-200 (default 50).",
     "example": 50
    },
    {
     "name": "q",
     "location": "query",
     "type": "string",
     "required": false,
     "description": "Words in the name or venue (2-80 letters or digits).",
     "example": "jazz"
    },
    {
     "name": "venue_id",
     "location": "query",
     "type": "string",
     "required": false,
     "description": "Only this organizer (id or slug).",
     "example": "blue-room"
    },
    {
     "name": "starts_after",
     "location": "query",
     "type": "string (ISO 8601)",
     "required": false,
     "description": "From this time (default now).",
     "example": "2026-12-01T00:00:00Z"
    },
    {
     "name": "starts_before",
     "location": "query",
     "type": "string (ISO 8601)",
     "required": false,
     "description": "Before this time.",
     "example": "2027-01-01T00:00:00Z"
    },
    {
     "name": "genre",
     "location": "query",
     "type": "string",
     "required": false,
     "description": "Only events with this genre (any case and spacing: \"Hip Hop\" matches \"hip  hop\").",
     "example": "House"
    },
    {
     "name": "genres",
     "location": "query",
     "type": "string",
     "required": false,
     "description": "Only events with at least one of these genres: comma-separated, or the parameter repeated (genres[] works too). With genre, the two are combined. At most 20.",
     "example": "house,techno"
    }
   ],
   "responses": [
    {
     "status": 200,
     "description": "OK.",
     "example": {
      "data": [
       {
        "id": "2b30d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
        "name": "Late Show",
        "slug": "late-show",
        "starts_at": "2026-12-12T02:00:00.000Z",
        "doors_at": "2026-12-12T01:00:00.000Z",
        "ends_at": null,
        "timezone": "America/New_York",
        "currency": "usd",
        "venue_name": "Blue Room",
        "venue_location": "New York, NY",
        "image_url": null,
        "category": "music",
        "sold_out": false,
        "org": {
         "id": "3c40e5a1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
         "name": "Blue Room",
         "slug": "blue-room"
        },
        "from_price_cents": 2800
       }
      ],
      "meta": {
       "page": 1,
       "per_page": 50,
       "total": 1,
       "total_pages": 1
      }
     }
    }
   ]
  },
  {
   "id": "public-discovery-event",
   "method": "GET",
   "path": "/v1/public/discovery/events/:id",
   "summary": "One event",
   "description": "A published event with its public ticket types, each priced all-in (price_cents) with whether it is on sale. Never counts or capacity. Opendate GET /public/discovery/confirms/{id}. No credential; CORS-open; 60 requests a minute per network (429 with Retry-After over it).",
   "auth": "public",
   "scope": null,
   "parameters": [
    {
     "name": "id",
     "location": "path",
     "type": "string (UUID)",
     "required": true,
     "description": "The event id.",
     "example": "2b30d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b"
    }
   ],
   "responses": [
    {
     "status": 200,
     "description": "OK.",
     "example": {
      "data": {
       "id": "2b30d4f1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
       "name": "Late Show",
       "slug": "late-show",
       "starts_at": "2026-12-12T02:00:00.000Z",
       "doors_at": "2026-12-12T01:00:00.000Z",
       "ends_at": null,
       "timezone": "America/New_York",
       "currency": "usd",
       "venue_name": "Blue Room",
       "venue_location": "New York, NY",
       "image_url": null,
       "category": "music",
       "sold_out": false,
       "org": {
        "id": "3c40e5a1-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
        "name": "Blue Room",
        "slug": "blue-room"
       },
       "from_price_cents": 2800,
       "ticket_types": [
        {
         "id": "11112222-1c2d-4e3f-8a9b-0c1d2e3f4a5b",
         "name": "GA",
         "description": null,
         "price_cents": 2800,
         "on_sale": true,
         "sold_out": false,
         "sales_start": null,
         "sales_end": null
        }
       ]
      }
     }
    },
    {
     "status": 404,
     "description": "Not a published event.",
     "example": {
      "error": "event not found"
     }
    }
   ]
  },
  {
