    {
      "auth": "api_key",
      "id": "issue-comps",
      "method": "POST",
      "path": "/v1/events/:id/comps",
      "summary": "Issue comps",
      "description": "Sends free tickets to up to 200 emails through the dashboard's comp batch: quantity_each per person (1-10), on tier_id (or the event's first ticket type). Each email gets its tickets by mail; results says per email what happened (outcome issued, invalid or sold-out, with detail). Send an Idempotency-Key so a resend doesn't issue twice.",
      "scope": "tickets:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event's id. One of another organization answers 404.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "emails",
          "location": "body",
          "type": "array",
          "required": true,
          "description": "Up to 200 email addresses.",
          "example": [
            "guest@example.com"
          ]
        },
        {
          "name": "tier_id",
          "location": "body",
          "type": "string (UUID)",
          "required": false,
          "description": "The ticket type to issue.",
          "example": "0b7e2d4c-5a61-4f38-9e2d-1c3b4a5d6e7f"
        },
        {
          "name": "quantity_each",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Tickets per email, 1-10 (default 1).",
          "example": 2
        },
        {
          "name": "Idempotency-Key",
          "location": "header",
          "type": "string",
          "required": false,
          "description": "Optional. 8-100 letters, digits, _ . : or -. Resending a write with the same key replays the first answer (with \"idempotent_replay\": true) instead of doing it again; the same key on another action or target answers 400.",
          "example": "7d0c9a52-2f1e-4b8e-9a43-6a1f0e2b5c77"
        }
      ],
      "request_example": {
        "tier_id": "0b7e2d4c-5a61-4f38-9e2d-1c3b4a5d6e7f",
        "emails": [
          "guest@example.com",
          "press@example.com"
        ],
        "quantity_each": 1
      },
      "responses": [
        {
          "status": 201,
          "description": "Created: per email, the outcome and the tickets.",
          "example": {
            "data": {
              "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
              "results": [
                {
                  "email": "guest@example.com",
                  "outcome": "issued",
                  "ticket_ids": [
                    "2b9e4f1a-7c3d-4e5f-8a6b-0c1d2e3f4a5b"
                  ],
                  "detail": null
                }
              ]
            }
          }
        },
        {
          "status": 400,
          "description": "A bad field or value; the message names it.",
          "example": {
            "error": "emails must be a list"
          }
        },
        {
          "status": 403,
          "description": "The key lacks tickets:write, or the member who created the key can't do this in the dashboard (owner or manager), or has left the organization.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "tickets:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"tickets:write\""
          }
        },
        {
          "status": 404,
          "description": "No such event in the key's organization (or the id is malformed).",
          "example": {
            "error": "event not found"
          }
        }
      ]
    },
