      "id": "get-payout",
      "method": "GET",
      "path": "/v1/payouts/:id",
      "summary": "Get a payout",
      "description": "One payout with its lines (the orders and adjustments it pays).",
      "scope": "finance:read",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
