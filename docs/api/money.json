{
  "file": "money",
  "name": "Refunds, comps and payouts",
  "order": 35,
  "description": "Routes that move money or give tickets away, and the records around them. Refunds need the refunds:write scope (no other scope grants it) and an Idempotency-Key; comps need tickets:write. Both run the dashboard's own functions as the member who created the key (refunds: owner, manager or finance; comps: owner or manager) and are logged as money-moving in the write log (GET /v1/api-writes).",
  "endpoints": [
    {
      "auth": "api_key",
      "id": "get-refund-preview",
      "method": "GET",
      "path": "/v1/orders/:id/refund-preview",
      "summary": "Preview a refund",
      "description": "What is left to refund on an order, per ticket (each ticket's share of what was paid, minus refunds already made). Same numbers as the dashboard's refund dialog; needs the key's creator to be an owner, manager or finance.",
      "scope": "orders:read",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "The order's id. One of another organization answers 404.",
          "example": "cs_live_a1B2c3D4e5F6"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "session_id": "cs_live_a1B2c3D4e5F6",
              "status": "partially_refunded",
              "currency": "usd",
              "amount_cents": 5000,
              "refunded_cents": 2500,
              "refundable_cents": 2500,
              "has_payment": true,
              "tickets": [
                {
                  "ticket_id": "2b9e4f1a-7c3d-4e5f-8a6b-0c1d2e3f4a5b",
                  "status": "active",
                  "share_cents": 2500,
                  "refunded_cents": 0,
                  "refundable_cents": 2500,
                  "tier_name": "GA",
                  "attendee_name": "Maya Chen"
                }
              ],
              "requests": []
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks orders:read, or the member who created the key can't do this in the dashboard (owner, manager or finance), or has left the organization.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "orders:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"orders:read\""
          }
        },
        {
          "status": 404,
          "description": "No such order in the key's organization (or the id is malformed).",
          "example": {
            "error": "order not found"
          }
        }
      ]
    },
    {
      "auth": "api_key",
      "id": "create-refund",
      "method": "POST",
      "path": "/v1/orders/:id/refunds",
      "summary": "Refund an order",
      "description": "Refunds to the buyer's card, exactly as the dashboard does: the amount is reserved under a lock (never more than is left), Stripe refunds it (reversing the transfer to the organizer), and tickets refunded in full are voided. Say what to refund: items (per ticket; an omitted amount_cents is what is left on that ticket), amount_cents (an amount on the order), or whole_order. The Idempotency-Key makes a resend safe: the same key always means the same refund. 502 means Stripe did not answer: resend with the same key and it completes without refunding twice. Payments switched off answers 503.",
      "scope": "refunds:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "The order's id. One of another organization answers 404.",
          "example": "cs_live_a1B2c3D4e5F6"
        },
        {
          "name": "Idempotency-Key",
          "location": "header",
          "type": "string",
          "required": true,
          "description": "Required. 8-100 letters, digits, _ . : or -; unique per request you mean (a UUID is ideal). Resending the same key never refunds twice: you get the same refund back. The key is bound to this order: reusing it on another order answers 400.",
          "example": "7d0c9a52-2f1e-4b8e-9a43-6a1f0e2b5c77"
        },
        {
          "name": "items",
          "location": "body",
          "type": "array",
          "required": false,
          "description": "Up to 100 { ticket_id, amount_cents? }.",
          "example": [
            {
              "ticket_id": "2b9e4f1a-7c3d-4e5f-8a6b-0c1d2e3f4a5b"
            }
          ]
        },
        {
          "name": "amount_cents",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "An amount on the order, in cents, not tied to tickets.",
          "example": 1000
        },
        {
          "name": "whole_order",
          "location": "body",
          "type": "boolean",
          "required": false,
          "description": "Refund everything still refundable.",
          "example": true
        },
        {
          "name": "reason",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Kept on the refund (up to 500 characters).",
          "example": "event moved, buyer can't make it"
        }
      ],
      "request_example": {
        "items": [
          {
            "ticket_id": "2b9e4f1a-7c3d-4e5f-8a6b-0c1d2e3f4a5b"
          }
        ],
        "reason": "buyer can't make it"
      },
      "responses": [
        {
          "status": 201,
          "description": "Created: Stripe accepted the refund (succeeded or pending).",
          "example": {
            "data": {
              "session_id": "cs_live_a1B2c3D4e5F6",
              "request_id": "4d5e6f7a-8b9c-4d0e-9f1a-2b3c4d5e6f7a",
              "amount_cents": 2500,
              "status": "succeeded",
              "voided": 1,
              "stripe_refund_id": "re_3PxAbC2eZvKYlo2C0Kq1",
              "idempotent_replay": false
            }
          }
        },
        {
          "status": 200,
          "description": "A resend of a refund that already went through: the same refund.",
          "example": {
            "data": {
              "session_id": "cs_live_a1B2c3D4e5F6",
              "request_id": "4d5e6f7a-8b9c-4d0e-9f1a-2b3c4d5e6f7a",
              "amount_cents": 2500,
              "status": "succeeded",
              "voided": 1,
              "stripe_refund_id": "re_3PxAbC2eZvKYlo2C0Kq1",
              "idempotent_replay": true
            }
          }
        },
        {
          "status": 400,
          "description": "No or a malformed Idempotency-Key, nothing to refund, more than is left, or the key was used on another order.",
          "example": {
            "error": "refunds need an Idempotency-Key header (8-100 letters, digits, _ . : or -)"
          }
        },
        {
          "status": 402,
          "description": "Stripe refused the refund; nothing was refunded and the reservation is released.",
          "example": {
            "data": {
              "session_id": "cs_live_a1B2c3D4e5F6",
              "request_id": "4d5e6f7a-8b9c-4d0e-9f1a-2b3c4d5e6f7a",
              "amount_cents": 2500,
              "status": "failed",
              "idempotent_replay": false,
              "error": "charge_already_refunded"
            }
          }
        },
        {
          "status": 403,
          "description": "The key lacks refunds:write, or the member who created the key can't do this in the dashboard (owner, manager or finance), or has left the organization.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "refunds:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"refunds:write\""
          }
        },
        {
          "status": 404,
          "description": "No such order in the key's organization (or the id is malformed).",
          "example": {
            "error": "order not found"
          }
        },
        {
          "status": 502,
          "description": "Stripe did not answer. Resend with the same Idempotency-Key: it will not refund twice.",
          "example": {
            "data": {
              "session_id": "cs_live_a1B2c3D4e5F6",
              "request_id": "4d5e6f7a-8b9c-4d0e-9f1a-2b3c4d5e6f7a",
              "amount_cents": 2500,
              "status": "claimed",
              "idempotent_replay": false,
              "error": "Stripe didn't answer; try again (it won't refund twice)"
            }
          }
        },
        {
          "status": 503,
          "description": "Payments are switched off on this install.",
          "example": {
            "error": "payments are switched off"
          }
        }
      ]
    },
    {
