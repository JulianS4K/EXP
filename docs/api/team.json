{
  "file": "team",
  "name": "Team",
  "order": 60,
  "description": "The organization, its members, invitations and roles. Managing the team is the owner's: an owner's own token (org:admin), or an API key an owner made. Owners themselves are changed in the dashboard. Removing or disabling a member revokes their API keys, personal tokens and OAuth grants for the organization at once; a demotion narrows their tokens on the next request. docs/developer-platform.md.",
  "endpoints": [
    {
      "id": "get-team",
      "method": "GET",
      "path": "/v1/team",
      "summary": "Get the organization",
      "auth": "api_key",
      "scope": "org:admin",
      "parameters": [],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
              "name": "Night Market Presents",
              "slug": "night-market",
              "created_at": "2026-05-01T10:00:00+00:00"
            }
          }
        },
        {
          "status": 403,
          "description": "The credential lacks org:admin.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "org:admin"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
          }
        }
      ]
    },
    {
      "id": "update-team",
      "method": "PATCH",
      "path": "/v1/team",
      "summary": "Rename the organization",
      "auth": "api_key",
      "scope": "org:admin",
      "parameters": [
        {
          "name": "name",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "1-80 characters.",
          "example": "Night Market Presents"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
              "name": "Night Market Presents",
              "slug": "night-market",
              "created_at": "2026-05-01T10:00:00+00:00"
            }
          }
        },
        {
          "status": 403,
          "description": "The credential lacks org:admin.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "org:admin"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
          }
        }
      ],
      "request_example": {
        "name": "Night Market Presents"
      }
    },
    {
      "id": "list-team-members",
      "method": "GET",
      "path": "/v1/team/members",
      "summary": "List members",
      "description": "Members with their role and whether they are disabled. `id` is the user id.",
      "auth": "api_key",
      "scope": "org:admin",
      "parameters": [],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "5e4d3c2b-1a09-4f8e-9d7c-6b5a49382716",
                "user_id": "5e4d3c2b-1a09-4f8e-9d7c-6b5a49382716",
                "email": "sam@example.com",
                "role": "manager",
                "disabled": false
              }
            ]
          }
        },
        {
          "status": 403,
          "description": "The credential lacks org:admin.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "org:admin"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
          }
        }
      ]
    },
    {
      "id": "update-team-member",
      "method": "PATCH",
      "path": "/v1/team/members/:id",
      "summary": "Change a member",
      "auth": "api_key",
      "scope": "org:admin",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The member's user id.",
          "example": "5e4d3c2b-1a09-4f8e-9d7c-6b5a49382716"
        },
        {
          "name": "role",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "The new role.",
          "example": "finance",
          "enum": [
            "manager",
            "finance",
            "content",
            "scanner"
          ]
        },
        {
          "name": "disabled",
          "location": "body",
          "type": "boolean",
          "required": false,
          "description": "true disables the member (and revokes their tokens), false re-enables.",
          "example": false
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "5e4d3c2b-1a09-4f8e-9d7c-6b5a49382716",
              "user_id": "5e4d3c2b-1a09-4f8e-9d7c-6b5a49382716",
              "email": "sam@example.com",
              "role": "finance",
              "disabled": false
            }
          }
        },
        {
          "status": 404,
          "description": "Not a member.",
          "example": {
            "error": "member not found"
          }
        },
        {
          "status": 409,
          "description": "An owner.",
          "example": {
            "error": "owners are changed in the dashboard, not through the API"
          }
        },
        {
          "status": 403,
          "description": "The credential lacks org:admin.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "org:admin"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
          }
        }
      ],
      "request_example": {
        "role": "finance"
      }
    },
    {
      "id": "remove-team-member",
      "method": "DELETE",
      "path": "/v1/team/members/:id",
      "summary": "Remove a member",
      "auth": "api_key",
      "scope": "org:admin",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The member's user id.",
          "example": "5e4d3c2b-1a09-4f8e-9d7c-6b5a49382716"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "5e4d3c2b-1a09-4f8e-9d7c-6b5a49382716",
              "removed": true
            }
          }
        },
        {
          "status": 404,
          "description": "Not a member.",
          "example": {
            "error": "member not found"
          }
        },
        {
          "status": 409,
          "description": "An owner.",
          "example": {
            "error": "owners are changed in the dashboard, not through the API"
          }
        },
        {
          "status": 403,
          "description": "The credential lacks org:admin.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "org:admin"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
          }
        }
      ]
    },
    {
      "id": "list-team-invitations",
      "method": "GET",
      "path": "/v1/team/invitations",
      "summary": "List invitations",
      "auth": "api_key",
      "scope": "org:admin",
      "parameters": [],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "9a8b7c6d-5e4f-4a3b-9c2d-1e0f9a8b7c6d",
                "token": "9a8b7c6d-5e4f-4a3b-9c2d-1e0f9a8b7c6d",
                "email": "lee@example.com",
                "role": "scanner",
                "status": "pending",
                "expires_at": "2026-11-14T10:00:00+00:00",
                "created_at": "2026-10-31T10:00:00+00:00"
              }
            ]
          }
        },
        {
          "status": 403,
          "description": "The credential lacks org:admin.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "org:admin"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
          }
        }
      ]
    },
    {
      "id": "create-team-invitation",
      "method": "POST",
      "path": "/v1/team/invitations",
      "summary": "Invite someone",
      "auth": "api_key",
      "scope": "org:admin",
      "parameters": [
        {
          "name": "email",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "Who to invite.",
          "example": "lee@example.com"
        },
        {
          "name": "role",
          "location": "body",
          "type": "string",
          "required": true,
          "description": "Their role.",
          "example": "scanner",
          "enum": [
            "manager",
            "finance",
            "content",
            "scanner"
          ]
        }
      ],
      "responses": [
        {
          "status": 201,
          "description": "Created; valid 14 days. Send invite_url to the person (no email is sent by the API).",
          "example": {
            "data": {
              "id": "9a8b7c6d-5e4f-4a3b-9c2d-1e0f9a8b7c6d",
              "token": "9a8b7c6d-5e4f-4a3b-9c2d-1e0f9a8b7c6d",
              "email": "lee@example.com",
              "role": "scanner",
              "status": "pending",
              "expires_at": "2026-11-14T10:00:00+00:00",
              "created_at": "2026-10-31T10:00:00+00:00",
              "invite_url": "https://tickets.example.com/bridge/invite/9a8b7c6d-5e4f-4a3b-9c2d-1e0f9a8b7c6d"
            }
          }
        },
        {
          "status": 403,
          "description": "The credential lacks org:admin.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "org:admin"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
          }
        }
      ],
      "request_example": {
        "email": "lee@example.com",
        "role": "scanner"
      }
    },
    {
      "id": "cancel-team-invitation",
      "method": "DELETE",
      "path": "/v1/team/invitations/:id",
      "summary": "Cancel an invitation",
      "auth": "api_key",
      "scope": "org:admin",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The invitation id.",
          "example": "9a8b7c6d-5e4f-4a3b-9c2d-1e0f9a8b7c6d"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "9a8b7c6d-5e4f-4a3b-9c2d-1e0f9a8b7c6d",
              "status": "cancelled"
            }
          }
        },
        {
          "status": 404,
          "description": "Not a pending invitation of this organization.",
          "example": {
            "error": "invitation not found"
          }
        },
        {
          "status": 403,
          "description": "The credential lacks org:admin.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "org:admin"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"org:admin\""
          }
        }
      ]
    },
    {
      "id": "list-team-roles",
      "method": "GET",
      "path": "/v1/team/roles",
      "summary": "List roles",
      "description": "The roles and the most a token of a user in each role can do (its scopes are narrowed to these on every request).",
      "auth": "api_key",
      "scope": null,
      "parameters": [],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "scanner",
                "name": "scanner",
                "description": "Reads events and tickets and checks people in.",
                "token_scopes": [
                  "events:read",
                  "tickets:read",
                  "checkin:write"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "list-my-memberships",
      "method": "GET",
      "path": "/v1/me/memberships",
      "summary": "List my organizations",
      "description": "Personal access tokens and OAuth tokens: the token's user's organizations. `current` marks the one this token acts on (a token is pinned to one).",
      "auth": "api_key",
      "scope": null,
      "parameters": [],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "org_id": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
                "name": "Night Market Presents",
                "slug": "night-market",
                "role": "manager",
                "current": true
              }
            ]
          }
        },
        {
          "status": 400,
          "description": "An organization API key.",
          "example": {
            "error": "an organization API key belongs to one organization; use GET /v1/me"
          }
        }
      ]
    },
    {
      "id": "revoke-current-token",
      "method": "DELETE",
      "path": "/v1/personal-access-tokens/current",
      "summary": "Revoke this token",
      "description": "Revokes the personal access token that makes the call. Personal tokens are created signed in, in Profile → Developer.",
      "auth": "api_key",
      "scope": null,
      "parameters": [],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "id": "6f5e4d3c-2b1a-4098-8f7e-6d5c4b3a2910",
              "revoked": true
            }
          }
        },
        {
          "status": 400,
          "description": "Not a personal access token.",
          "example": {
            "error": "API keys are revoked in Org settings"
          }
        }
      ]
    }
  ]
}
