{
  "file": "ticket-reservations",
  "name": "Ticket reservations",
  "order": 52,
  "description": "Reservations hold seats for 10 minutes and become orders when completed. Partners make them through the partner contract; your own systems (a box office, a kiosk) make organizer reservations here with `tickets:write`, on the same core: any ticket type of the event, all-in prices, holds that count against every channel, and live-ticket links on completion (channel_source `api`). docs/partner-sales.md.",
  "endpoints": [
    {
      "id": "list-ticket-reservations",
      "method": "GET",
      "path": "/v1/events/:id/ticket-reservations",
      "summary": "List an event's reservations",
      "description": "Partner and organizer reservations of the event, newest first, amounts in cents.",
      "auth": "api_key",
      "scope": "orders:read",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event id.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "status",
          "location": "query",
          "type": "string",
          "required": false,
          "description": "Only reservations in this status.",
          "example": "completed",
          "enum": [
            "active",
            "completed",
            "cancelled",
            "expired"
          ]
        },
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
          "example": 1,
          "default": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "description": "Rows per page, 1-200 (default 50).",
          "example": 50,
          "default": 50
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "0d9c8b7a-6f5e-4d3c-9b2a-1f0e9d8c7b6a",
                "token": "rsv_Q2xhc3NpY19yZXNlcnZhdGlvbl90b2tlbl9leGFtcGxlMQ",
                "status": "completed",
                "channel": "partner",
                "channel_source": "partner:stubhub",
                "partner_id": "b7e6d5c4-3b2a-4190-8f7e-6d5c4b3a2918",
                "quantity": 2,
                "currency": "usd",
                "subtotal_cents": 5000,
                "fees_cents": 400,
                "tax_cents": 0,
                "total_cents": 5400,
                "cash_paid_cents": 5400,
                "first_name": "Jane",
                "last_name": "Buyer",
                "email": "jane@example.com",
                "external_id": "SH-88231",
                "expires_at": "2026-10-31T18:10:00+00:00",
                "completed_at": "2026-10-31T18:03:00+00:00",
                "cancelled_at": null,
                "created_at": "2026-10-31T18:00:00+00:00"
              }
            ],
            "meta": {
              "page": 1,
              "per_page": 50,
              "total": 1,
              "total_pages": 1
            }
          }
        },
        {
          "status": 404,
          "description": "Not an event of this organization.",
          "example": {
            "error": "event not found"
          }
        },
        {
          "status": 403,
          "description": "The credential lacks orders:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "orders:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"orders:read\""
          }
        }
      ]
    },
    {
