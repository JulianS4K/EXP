    {
      "id": "cancel-organizer-reservation",
      "method": "DELETE",
      "path": "/v1/events/:id/organizer-reservations/:token",
      "summary": "Cancel a reservation",
      "description": "The seats go back on sale. Cancelling twice is fine.",
      "auth": "api_key",
      "scope": "tickets:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event id.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "token",
          "location": "path",
          "type": "string",
          "required": true,
          "description": "The reservation token (rsv_…).",
          "example": "rsv_Q2xhc3NpY19yZXNlcnZhdGlvbl90b2tlbl9leGFtcGxlMQ"
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "token": "rsv_Q2xhc3NpY19yZXNlcnZhdGlvbl90b2tlbl9leGFtcGxlMQ",
              "status": "cancelled",
              "released": true
            }
          }
        },
        {
          "status": 409,
          "description": "Already completed.",
          "example": {
            "error": "this reservation was completed; it can no longer be cancelled"
          }
        },
        {
          "status": 403,
          "description": "The credential lacks tickets:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "tickets:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"tickets:write\""
          }
        }
      ]
    },
