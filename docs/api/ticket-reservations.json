    {
      "id": "build-organizer-reservation",
      "method": "POST",
      "path": "/v1/events/:id/organizer-reservations/build",
      "summary": "Price a reservation",
      "description": "What a reservation would cost, checked like a real one (availability, sales window), without holding anything.",
      "auth": "api_key",
      "scope": "tickets:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event id.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "ticket_reservation[order_items_attributes]",
          "location": "body",
          "type": "array of object",
          "required": true,
          "description": "1-10 lines of { ticket_type_id, quantity } (quantity 1-100, at most 100 tickets in all). JSON (nested or flat) and Rails-style form fields both work.",
          "example": [
            {
              "ticket_type_id": "8c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
              "quantity": 2
            }
          ]
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": {
              "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
              "currency": "USD",
              "order_items": [
                {
                  "ticket_type_id": "8c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
                  "name": "General admission",
                  "quantity": 2,
                  "price": 25.0,
                  "fees_total": 4.0,
                  "taxes_total": 0.0,
                  "total": 54.0
                }
              ],
              "subtotal": 50.0,
              "fees_total": 4.0,
              "taxes_total": 0.0,
              "total": 54.0
            }
          }
        },
        {
          "status": 409,
          "description": "Not enough seats left: nothing was held, don't charge your buyer.",
          "example": {
            "error": "sold out: General admission has 1 left",
            "reason": "sold_out"
          }
        },
        {
          "status": 422,
          "description": "The ticket type isn't offered to you (switch off, paused, sales window, not this event) or the event can't sell now.",
          "example": {
            "error": "ticket type 8c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f is not available for distribution",
            "reason": "not_available"
          }
        },
        {
          "status": 403,
          "description": "The credential lacks tickets:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "tickets:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"tickets:write\""
          }
        }
      ],
      "request_example": {
        "ticket_reservation": {
          "order_items_attributes": [
            {
              "ticket_type_id": "8c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
              "quantity": 2
            }
          ]
        }
      }
    },
    {
      "id": "create-organizer-reservation",
      "method": "POST",
      "path": "/v1/events/:id/organizer-reservations",
      "summary": "Reserve tickets",
      "description": "Holds the seats for 10 minutes. Any ticket type of the event (hidden ones too); never table types.",
      "auth": "api_key",
      "scope": "tickets:write",
      "parameters": [
        {
          "name": "id",
          "location": "path",
          "type": "string (UUID)",
          "required": true,
          "description": "The event id.",
          "example": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14"
        },
        {
          "name": "ticket_reservation[order_items_attributes]",
          "location": "body",
          "type": "array of object",
          "required": true,
          "description": "1-10 lines of { ticket_type_id, quantity } (quantity 1-100, at most 100 tickets in all). JSON (nested or flat) and Rails-style form fields both work.",
          "example": [
            {
              "ticket_type_id": "8c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
              "quantity": 2
            }
          ]
        },
        {
          "name": "ticket_reservation[cash_paid]",
          "location": "body",
          "type": "number",
          "required": false,
          "description": "What you collected from your buyer, in major units; recorded for reconciliation.",
          "example": 54.0
        },
        {
          "name": "ticket_reservation[should_send_ticket_email]",
          "location": "body",
          "type": "boolean",
          "required": false,
          "description": "Email the buyer their live-ticket links when the reservation completes (needs an email). Default false: you deliver.",
          "example": false
        },
        {
          "name": "ticket_reservation[stubhub_transaction_id]",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Your own transaction id (at most 128 letters, digits or . _ - : # /); filter orders by it later.",
          "example": "SH-88231"
        },
        {
          "name": "ticket_reservation[first_name]",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Attendee first name (at most 60 characters).",
          "example": "Jane"
        },
        {
          "name": "ticket_reservation[last_name]",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Attendee last name.",
          "example": "Buyer"
        },
        {
          "name": "ticket_reservation[email]",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "Attendee email.",
          "example": "jane@example.com"
        }
      ],
      "responses": [
        {
          "status": 201,
          "description": "Held for 10 minutes.",
          "example": {
            "data": {
              "token": "rsv_Q2xhc3NpY19yZXNlcnZhdGlvbl90b2tlbl9leGFtcGxlMQ",
              "status": "active",
              "expires_at": "2026-10-31T18:10:00+00:00",
              "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
              "confirm_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
              "currency": "USD",
              "order_items": [
                {
                  "ticket_type_id": "8c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
                  "name": "General admission",
                  "quantity": 2,
                  "price": 25.0,
                  "fees_total": 4.0,
                  "taxes_total": 0.0,
                  "total": 54.0
                }
              ],
              "subtotal": 50.0,
              "fees_total": 4.0,
              "taxes_total": 0.0,
              "total": 54.0,
              "cash_paid": 54.0,
              "should_send_ticket_email": false,
              "first_name": null,
              "last_name": null,
              "email": null,
              "stubhub_transaction_id": null,
              "order_id": null,
              "created_at": "2026-10-31T18:00:00+00:00",
              "updated_at": "2026-10-31T18:00:00+00:00"
            }
          }
        },
        {
          "status": 409,
          "description": "Not enough seats left: nothing was held, don't charge your buyer.",
          "example": {
            "error": "sold out: General admission has 1 left",
            "reason": "sold_out"
          }
        },
        {
          "status": 422,
          "description": "The ticket type isn't offered to you (switch off, paused, sales window, not this event) or the event can't sell now.",
          "example": {
            "error": "ticket type 8c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f is not available for distribution",
            "reason": "not_available"
          }
        },
        {
          "status": 403,
          "description": "The credential lacks tickets:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "tickets:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"tickets:write\""
          }
        }
      ],
      "request_example": {
        "ticket_reservation": {
          "order_items_attributes": [
            {
              "ticket_type_id": "8c1d2e3f-4a5b-4c6d-8e7f-9a0b1c2d3e4f",
              "quantity": 2
            }
          ],
          "cash_paid": 54.0
        }
      }
    },
