{
  "file": "finance-extras",
  "name": "Deal brackets, ledger codes and reporting",
  "order": 66,
  "description": "Tiered deal brackets on offers (`booking:*`); ledger codes per revenue type with per-event overrides and backfills, imported ledger entries, the reporting-row feed and each event's cash summary (`finance:*`). Money is in integer cents.",
  "endpoints": [
    {
      "id": "list-deal-brackets",
      "method": "GET",
      "path": "/v1/deal-brackets",
      "summary": "List deal brackets",
      "description": "Tiered deal terms on your offers, by offer and threshold. Opendate's /v3_deal_brackets answers here too (q[v3_budget_id_eq] filters by budget).",
      "auth": "api_key",
      "scope": "booking:read",
      "parameters": [
        {
          "name": "offer_id",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Only this offer's brackets.",
          "example": "9a1b2c3d-4e5f-4a6b-8c7d-0e1f2a3b4c5d"
        },
        {
          "name": "budget_id",
          "location": "query",
          "type": "string (UUID)",
          "required": false,
          "description": "Only brackets of offers on this budget.",
          "example": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f"
        },
        {
          "name": "page",
          "location": "query",
          "type": "integer",
          "required": false,
          "description": "Page number, 1-10000 (default 1). A page past the end answers an empty data array.",
          "example": 1,
          "default": 1
        },
        {
          "name": "per_page",
          "location": "query",
          "type": "integer",
          "required": false,
          "description": "Rows per page, 1-200 (default 50).",
          "example": 50,
          "default": 50
        }
      ],
      "responses": [
        {
          "status": 200,
          "description": "OK.",
          "example": {
            "data": [
              {
                "id": "5b6c7d8e-9f0a-4b1c-8d2e-3f4a5b6c7d8e",
                "offer_id": "9a1b2c3d-4e5f-4a6b-8c7d-0e1f2a3b4c5d",
                "basis": "amount",
                "threshold": 2000000,
                "percentage": 90,
                "created_at": "2026-11-02T15:04:05.120+00:00",
                "updated_at": "2026-11-02T15:04:05.120+00:00",
                "budget_id": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
                "offer_status": "draft"
              }
            ],
            "meta": {
              "page": 1,
              "per_page": 50,
              "total": 1,
              "total_pages": 1
            }
          }
        },
        {
          "status": 400,
          "description": "The body or a parameter is not valid.",
          "example": {
            "error": "offer_id must be an id."
          }
        },
        {
          "status": 403,
          "description": "The key lacks booking:read.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "booking:read"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"booking:read\""
          }
        }
      ]
    },
    {
