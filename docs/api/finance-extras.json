    {
      "id": "import-ledger-entries",
      "method": "POST",
      "path": "/v1/imported-ledger-entries/bulk",
      "summary": "Import ledger entries",
      "description": "1 to 500 entries; each is applied on its own and reported as created, exists or error. A line is identified by source_system + source_line_id: sending it again with the same values is `exists` and writes nothing, so a batch can be re-sent; the same line with other values is an error naming the stored entry (delete it first). Amounts are signed integer cents (a cost or a gift-card spend is negative). Entries on an event count in its settlement and profit and loss under Imported lines, and become reporting rows at once (imported: true).",
      "auth": "api_key",
      "scope": "finance:write",
      "parameters": [
        {
          "name": "entries",
          "location": "body",
          "type": "array",
          "required": true,
          "description": "1-500 of { event_id?, source, description?, amount_cents, tax_amount_cents?, currency?, gl_code?, tax_gl_code?, tax_name?, posted_at, source_system, source_line_id, source_order_id?, import_run_id? }. Opendate's imported_ledger_entries key is accepted.",
          "example": [
            {
              "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
              "source": "bar",
              "description": "Bar night",
              "amount_cents": 50000,
              "tax_amount_cents": 4000,
              "gl_code": "4100",
              "posted_at": "2026-11-01T22:00:00Z",
              "source_system": "square",
              "source_line_id": "sq:1"
            }
          ]
        }
      ],
      "responses": [
        {
          "status": 201,
          "description": "Imported (see each row's status).",
          "example": {
            "data": {
              "created": 1,
              "exists": 1,
              "errors": 1,
              "results": [
                {
                  "index": 1,
                  "status": "created",
                  "id": "7d8e9f0a-1b2c-4d3e-8f4a-5b6c7d8e9f0a"
                },
                {
                  "index": 2,
                  "status": "exists",
                  "id": "0b1c2d3e-4f5a-4b6c-8d7e-9f0a1b2c3d4e"
                },
                {
                  "index": 3,
                  "status": "error",
                  "error": "amount_cents must be a whole number of cents"
                }
              ]
            }
          }
        },
        {
          "status": 400,
          "description": "The body or a parameter is not valid.",
          "example": {
            "error": "At most 500 entries per import."
          }
        },
        {
          "status": 403,
          "description": "The key lacks finance:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "finance:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"finance:write\""
          }
        }
      ],
      "request_example": {
        "entries": [
          {
            "event_id": "3f6b2c1e-8a4d-4e2f-9b1a-7c5d0e9f2a14",
            "source": "bar",
            "description": "Bar night",
            "amount_cents": 50000,
            "tax_amount_cents": 4000,
            "gl_code": "4100",
            "posted_at": "2026-11-01T22:00:00Z",
            "source_system": "square",
            "source_line_id": "sq:1"
          }
        ]
      }
    },
