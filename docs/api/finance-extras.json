        {
          "name": "threshold",
          "location": "body",
          "type": "integer",
          "required": false,
          "description": "Where the bracket starts: cents (amount) or paid tickets (tickets). Below the lowest threshold the offer's own percentage applies; thresholds are unique per offer, so brackets never overlap.",
          "example": 2000000
