              "offer_id": "9a1b2c3d-4e5f-4a6b-8c7d-0e1f2a3b4c5d",
              "basis": "amount",
              "threshold": 2000000,
              "percentage": 90,
              "created_at": "2026-11-02T15:04:05.120+00:00",
              "updated_at": "2026-11-02T15:04:05.120+00:00",
              "budget_id": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
