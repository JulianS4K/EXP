    {
      "id": "create-deal-bracket",
      "method": "POST",
      "path": "/v1/deal-brackets",
      "summary": "Add a deal bracket to an offer",
      "description": "Example: an offer at 85% with a bracket { threshold: 2000000, percentage: 90 } pays 85% of the first $20,000 and 90% of the rest. Brackets apply to versus, plus and door deals and change only while the offer is a draft (409 otherwise); the settlement computes the tiered amount. At most 20 per offer. A wrapped body ({ v3_deal_bracket: {...} }) is fine.",
      "auth": "api_key",
      "scope": "booking:write",
      "parameters": [
        {
          "name": "offer_id",
          "location": "body",
          "type": "string (UUID)",
          "required": true,
          "description": "One of your offers (Opendate: v3_offer_id).",
          "example": "9a1b2c3d-4e5f-4a6b-8c7d-0e1f2a3b4c5d"
        },
        {
          "name": "basis",
          "location": "body",
          "type": "string",
          "required": false,
          "description": "What the thresholds count: amount (the cents the deal's percentage applies to: net after expenses for versus, net box office for door, the overage for plus) or tickets (paid tickets sold). Every bracket of an offer has the same basis. Opendate's gross_ticket_sales and ticket_count are accepted. Default amount.",
          "example": "amount",
          "enum": [
            "amount",
            "tickets"
          ]
        },
        {
          "name": "threshold",
          "location": "body",
          "type": "integer",
          "required": true,
          "description": "Where the bracket starts: cents (amount) or paid tickets (tickets). Below the lowest threshold the offer's own percentage applies; thresholds are unique per offer, so brackets never overlap.",
          "example": 2000000
        },
        {
          "name": "percentage",
          "location": "body",
          "type": "number",
          "required": true,
          "description": "The percentage from the threshold up, 0-100 with at most 3 decimals (Opendate: upside_percentage).",
          "example": 90
        }
      ],
      "responses": [
        {
          "status": 201,
          "description": "Created.",
          "example": {
            "data": {
              "id": "5b6c7d8e-9f0a-4b1c-8d2e-3f4a5b6c7d8e",
              "offer_id": "9a1b2c3d-4e5f-4a6b-8c7d-0e1f2a3b4c5d",
              "basis": "amount",
              "threshold": 2000000,
              "percentage": 90,
              "created_at": "2026-11-02T15:04:05.120+00:00",
              "updated_at": "2026-11-02T15:04:05.120+00:00",
              "budget_id": "1c2d3e4f-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
              "offer_status": "draft"
            }
          }
        },
        {
          "status": 400,
          "description": "The body or a parameter is not valid.",
          "example": {
            "error": "threshold is required: the cents (amount) or paid tickets (tickets) from which the percentage applies."
          }
        },
        {
          "status": 404,
          "description": "No such offer in your organization.",
          "example": {
            "error": "offer not found"
          }
        },
        {
          "status": 409,
          "description": "The offer is not a draft, or the offer already has 20 brackets.",
          "example": {
            "error": "brackets change only on a draft offer (edit its terms to take a sent offer back to draft)"
          }
        },
        {
          "status": 403,
          "description": "The key lacks booking:write.",
          "example": {
            "error": "insufficient scope",
            "required_scope": "booking:write"
          },
          "headers": {
            "WWW-Authenticate": "Bearer error=\"insufficient_scope\", scope=\"booking:write\""
          }
        }
      ],
      "request_example": {
        "offer_id": "9a1b2c3d-4e5f-4a6b-8c7d-0e1f2a3b4c5d",
        "basis": "amount",
        "threshold": 2000000,
        "percentage": 90
      }
    },
