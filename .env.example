# ---------------------------------------------------------------------------
# Server runtime
# ---------------------------------------------------------------------------

# Port the Express server binds to. PaaS platforms (Cloud Run, Render,
# Heroku, Fly, etc.) inject this — leave unset locally to default to 3000.
PORT=

# Defaults to 0.0.0.0 which is correct for containers and reverse proxies.
# Set to 127.0.0.1 if you want to bind only to loopback during local dev.
HOST=

# Set to "production" when running `npm start` against a built bundle.
NODE_ENV=

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------

# Stripe Publishable Key (read by the Vite client at build time).
VITE_STRIPE_PUBLISHABLE_KEY=

# Public app URL used to build Stripe success/cancel redirect URLs.
# Example: https://vibepass.example.com
VITE_APP_URL=

# Google Maps Embed API key for the venue map on event pages (optional; without
# it pages show a "Directions" link only). It ships in the bundle, so restrict
# it in Google Cloud to the Maps Embed API and to our HTTP referrers.
VITE_GOOGLE_MAPS_EMBED_KEY=

# Interactive maps (docs/maps.md): Maps JavaScript API browser key (restrict to
# that API + our referrers) and a Map ID (AdvancedMarker needs one; falls back
# to DEMO_MAP_ID). Geocoding never runs in the browser: the server key
# GOOGLE_MAPS_SERVER_KEY is a Supabase edge-function secret, not a VITE_ var.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# ---------------------------------------------------------------------------
# Firebase  (web config — injected at build via VITE_FIREBASE_*, NOT committed)
# ---------------------------------------------------------------------------
# The web "apiKey" is a public app identifier (not a secret) — access control
# is enforced by `firestore.rules`. We still keep it out of the repo so the
# committed static bundle carries no key and config is injected per-env at
# deploy. Leave blank locally if you're only exercising the Supabase path;
# Firebase ops no-op without a valid config (it's being migrated out).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_FIRESTORE_DB_ID=

# ---------------------------------------------------------------------------
# Supabase (D4 / Exos data plane — migrating off Firebase)
# ---------------------------------------------------------------------------
# Project URL, e.g. https://hzrizjeaxlqcxfrtczpq.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/publishable key (read by the Vite client). Public identifier —
# row access is enforced by RLS on the exos_* tables, not by hiding this key.
VITE_SUPABASE_ANON_KEY=
