# Read-only Postgres URL for the Terminal-2 Supabase project (use a read-only role
# through the pooler; EXP never writes). Required in production.
EXP_DATABASE_URL=postgresql://exp_ro:***@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Where the VibePass row's Buy button points (no trailing slash).
EXP_STOREFRONT_BASE_URL=https://vibepass-storefront-test.onrender.com
# Our TEvo brokerage id; owned rows under it are the VibePass book.
EXP_OWN_BROKERAGE_ID=1768
# Freshness window for a marketplace capture to count as a price.
EXP_MAX_AGE_HOURS=24
# Optional fee-model override, JSON keyed by source (see exp/fees.py).
# EXP_FEE_MODEL_JSON={"vibepass":{"basis":"plus_fees","pct":0.10,"fixed_per_ticket":2.5}}
